@model DeliveryManagement.Models.DeliveryOrder
@using Microsoft.AspNetCore.Identity
@using DeliveryManagement.Models

@{
    ViewData["Title"] = "Chi tiết đơn hàng";

    var isReceptionist = User.IsInRole("ReceptionStaff")
        || User.IsInRole("Admin");

    var isCustomer = User.IsInRole("Customer");
    var isDelivered = Model.CurrentStatus == "Đã Giao";

    var orderReview = ViewBag.OrderReview as Review;
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="mb-1">Chi tiết đơn hàng</h2>
            <p class="text-muted mb-0">Mã đơn: <strong>@Model.OrderCode</strong></p>
        </div>
        <div class="d-flex gap-2">
            @if (isReceptionist)
            {
                <a asp-action="PrintWaybill"
                   asp-route-id="@Model.OrderCode"
                   target="_blank"
                   class="btn btn-outline-dark fw-bold rounded-pill px-3 shadow-sm">
                    <i class="bi bi-printer-fill me-1"></i>
                    In phiếu gửi hàng
                </a>
            }
            <a asp-action="Index" class="btn btn-light border rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Danh sách đơn
            </a>
        </div>
    </div>

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 bg-light rounded">
            <span>
                Trạng thái đơn hàng:
                <strong class="text-primary fs-5">@Model.CurrentStatus</strong>
            </span>

            <div class="d-flex flex-wrap gap-2">
                @if (isCustomer && isDelivered)
                {
                    @if (orderReview == null)
                    {
                        <a asp-controller="Reviews"
                           asp-action="Create"
                           asp-route-orderCode="@Model.OrderCode"
                           class="btn btn-warning fw-bold">
                            <i class="bi bi-star-fill me-1"></i>
                            Đánh giá đơn hàng
                        </a>
                    }
                    else
                    {
                        <span class="badge bg-success p-2 d-flex align-items-center">
                            <i class="bi bi-check-circle me-1"></i>
                            Đã đánh giá
                        </span>
                    }
                }

                @if (Model.CurrentStatus == "Chưa nhận")
                {
                    <form asp-action="Cancel"
                          method="post"
                          onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.OrderCode" />
                        <button type="submit" class="btn btn-danger text-white fw-bold">
                            Hủy yêu cầu giao hàng
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @* Hiển thị đánh giá và phản hồi đã có của khách hàng *@
    @if (isCustomer && orderReview != null)
    {
        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-header bg-white fw-bold">
                Đánh giá của bạn
            </div>
            <div class="card-body">
                <div class="text-warning fs-4 mb-2" aria-label="@orderReview.Rating trên 5 sao">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= orderReview.Rating)
                        {
                            <span>★</span>
                        }
                        else
                        {
                            <span class="text-secondary">☆</span>
                        }
                    }
                </div>

                <p class="mb-2">@orderReview.Comment</p>
                <small class="text-muted">
                    Đánh giá lúc: @orderReview.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </small>

                @if (!string.IsNullOrWhiteSpace(orderReview.Response))
                {
                    <hr />
                    <div class="bg-light rounded p-3">
                        <strong class="text-primary">Phản hồi từ nhân viên</strong>
                        <p class="mb-1 mt-2">@orderReview.Response</p>
                        <small class="text-muted">
                            @(orderReview.Staff?.FullName ?? "Nhân viên")
                            @if (orderReview.RespondedAt.HasValue)
                            {
                                <span> - @orderReview.RespondedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                            }
                        </small>
                    </div>
                }
            </div>
        </div>
    }

    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-white fw-bold border-bottom-0 pt-3">1. Thông tin vận chuyển</div>
                <div class="card-body border rounded m-3 mt-0">
                    <h6 class="fw-bold text-secondary">Người gửi</h6>
                    <p class="mb-1">Họ tên: @Model.SenderName</p>
                    <p class="mb-1">SĐT: @Model.SenderPhone</p>
                    <p class="mb-3">Địa chỉ: @Model.SenderAddress</p>
                    <hr />
                    <h6 class="fw-bold text-secondary">Người nhận</h6>
                    <p class="mb-1">Họ tên: @Model.ReceiverName</p>
                    <p class="mb-1">SĐT: @Model.ReceiverPhone</p>
                    <p class="mb-0">Địa chỉ: @Model.ReceiverAddress</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header bg-white fw-bold border-bottom-0 pt-3">2. Thông tin hàng hóa</div>
                <div class="card-body bg-light rounded m-3 mt-0">
                    @if (Model.OrderItems.Any())
                    {
                        var index = 1;
                        foreach (var item in Model.OrderItems)
                        {
                            <div class="@(index > 1 ? "border-top pt-3 mt-3" : "")">
                                <h6 class="fw-bold text-secondary">Hàng hóa @index</h6>
                                <p class="mb-1"><strong>Loại đóng gói:</strong> @(item.PackageType?.TypeName ?? "Chưa phân loại")</p>
                                <p class="mb-1"><strong>Khối lượng:</strong> @item.Weight kg</p>
                                <p class="mb-1"><strong>Số lượng:</strong> @item.Quantity</p>
                                <p class="mb-2"><strong>Mô tả:</strong> @item.Description</p>

                                <div class="mt-2">
                                    <span class="badge @(item.IsFragile ? "bg-danger" : "bg-secondary")">@(item.IsFragile ? "Hàng dễ vỡ" : "Không dễ vỡ")</span>
                                    <span class="badge @(item.IsValuable ? "bg-warning text-dark" : "bg-secondary") ms-1">@(item.IsValuable ? "Hàng giá trị cao" : "Hàng thường")</span>
                                </div>
                            </div>
                            index++;
                        }

                        <div class="mt-3 p-3 bg-white rounded border">
                            <h6 class="fw-bold mb-2 text-primary small"><i class="bi bi-receipt me-1"></i>Chi tiết cước phí (@Model.DeliveryMethod - @Model.DistanceKm km)</h6>
                            <div class="d-flex justify-content-between text-muted small py-1 border-bottom">
                                <span>Cước vận chuyển cơ bản:</span>
                                <span>@(Model.BaseShippingFee > 0 ? Model.BaseShippingFee.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " VNĐ" : "-")</span>
                            </div>
                            @if (Model.WeightFee > 0)
                            {
                                <div class="d-flex justify-content-between text-muted small py-1 border-bottom">
                                    <span>Phụ phí vượt khối lượng:</span>
                                    <span>+@Model.WeightFee.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) VNĐ</span>
                                </div>
                            }
                            @if (Model.WeatherFee > 0 || !string.IsNullOrEmpty(Model.WeatherDescription))
                            {
                                <div class="d-flex justify-content-between text-danger small py-1 border-bottom">
                                    <span>Phụ thu thời tiết (@(Model.WeatherDescription ?? "Thời tiết xấu")):</span>
                                    <span>+@Model.WeatherFee.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) VNĐ</span>
                                </div>
                            }
                            @if (Model.TrafficFee > 0 || !string.IsNullOrEmpty(Model.TrafficDescription))
                            {
                                <div class="d-flex justify-content-between text-warning small py-1 border-bottom">
                                    <span>Phụ thu giao thông (@(Model.TrafficDescription ?? "Cao điểm")):</span>
                                    <span>+@Model.TrafficFee.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) VNĐ</span>
                                </div>
                            }
                            <div class="d-flex justify-content-between fw-bold text-primary fs-6 pt-2">
                                <span>Tổng thanh toán:</span>
                                <span>@(Model.TotalAmount > 0 ? Model.TotalAmount.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " VNĐ" : "Chờ xác định")</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-danger mb-0">Chưa có thông tin chi tiết hàng hóa cho đơn này.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>