@model DeliveryManagement.Models.ViewModels.CreateOrderViewModel

@{
    ViewData["Title"] = "Tạo yêu cầu giao hàng";

    var packageTypes = ViewBag.PackageTypes
        as List<DeliveryManagement.Models.PackageType>
        ?? new List<DeliveryManagement.Models.PackageType>();

    var savedAddresses = ViewBag.SenderAddresses
        as List<DeliveryManagement.Models.SenderAddress>
        ?? new List<DeliveryManagement.Models.SenderAddress>();
}

<div class="order-create-page">

    <div class="order-create-header">
        <div>
            <h1>Tạo yêu cầu giao hàng</h1>
            <p>Nhập thông tin tạo yêu cầu giao hàng mới</p>
        </div>
    </div>


    <form asp-controller="DeliveryOrder"
          asp-action="Create"
          method="post"
          class="order-form">

        <input type="hidden" asp-for="Latitude" id="senderLat" />
        <input type="hidden" asp-for="Longitude" id="senderLon" />

        <div asp-validation-summary="All"
             class="text-danger validation-summary"></div>


        <!-- =========================
             1. THÔNG TIN NGƯỜI GỬI
             ========================= -->

        <div class="order-section">

            <div class="order-section-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h2>1. Thông tin người gửi</h2>
                    <p class="text-muted small mb-0">Nhập địa chỉ lấy hàng hoặc chọn nhanh từ sổ địa chỉ đã lưu</p>
                </div>
                <div>
                    <a asp-controller="Sender" asp-action="Index" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill">
                        <i class="bi bi-journal-bookmark-fill me-1 text-primary"></i> Quản lý sổ địa chỉ
                    </a>
                </div>
            </div>

            @if (savedAddresses.Any())
            {
                <div class="mb-3 p-3 bg-light rounded-3 border">
                    <label class="form-label fw-bold text-dark small mb-2 d-flex align-items-center">
                        <i class="bi bi-bookmark-star-fill text-warning me-2"></i> Chọn nhanh từ sổ địa chỉ người gửi:
                    </label>
                    <select id="selectSavedAddress" class="form-select border-primary shadow-xs">
                        <option value="">-- Chọn địa chỉ có sẵn hoặc nhập mới bên dưới --</option>
                        @foreach (var a in savedAddresses)
                        {
                            <option value="@a.Id"
                                    data-name="@a.SenderName"
                                    data-phone="@a.SenderPhone"
                                    data-address="@a.SenderAddressText">
                                @(a.IsDefault ? "⭐ [Mặc định] " : "")@a.AddressTag: @a.SenderName - @a.SenderPhone - @a.SenderAddressText
                            </option>
                        }
                    </select>
                </div>
            }

            <div class="order-form-grid">

                <div class="form-group">

                    <label asp-for="SenderName"
                           class="form-label">
                        Họ và tên
                    </label>

                    <input asp-for="SenderName"
                           id="SenderNameInput"
                           class="form-control"
                           placeholder="Nhập họ và tên người gửi" />

                    <span asp-validation-for="SenderName"
                          class="field-validation-error"></span>

                </div>


                <div class="form-group">

                    <label asp-for="SenderPhone"
                           class="form-label">
                        Số điện thoại
                    </label>

                    <input asp-for="SenderPhone"
                           id="SenderPhoneInput"
                           class="form-control"
                           placeholder="Nhập số điện thoại" />

                    <span asp-validation-for="SenderPhone"
                          class="field-validation-error"></span>

                </div>

            </div>


            <div class="form-group">

                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="SenderAddress"
                           class="form-label mb-0">
                        Địa chỉ
                    </label>

                    <button type="button"
                            class="btn btn-sm btn-link text-primary p-0 text-decoration-none"
                            id="btnLocateAddress"
                            title="Lấy vị trí GPS hiện tại">
                        <i class="bi bi-crosshair"></i> Định vị vị trí của tôi
                    </button>
                </div>

                <input asp-for="SenderAddress"
                       id="SenderAddressInput"
                       class="form-control"
                       placeholder="Nhập địa chỉ người gửi" />

                <div id="locationBadge" class="mt-1 small text-success" style="display:none;">
                    <i class="bi bi-geo-alt-fill"></i> <span id="locationBadgeText">Đã xác định vị trí GPS</span>
                </div>

                <span asp-validation-for="SenderAddress"
                      class="field-validation-error"></span>

            </div>

            <div class="row mt-2 g-2 align-items-center">
                <div class="col-md-6">
                    <div class="form-check">
                        <input asp-for="SaveToAddressBook" class="form-check-input" type="checkbox" id="chkSaveAddress">
                        <label class="form-check-label small fw-semibold text-secondary" for="chkSaveAddress">
                            <i class="bi bi-plus-square me-1"></i> Lưu thông tin này vào sổ địa chỉ người gửi
                        </label>
                    </div>
                </div>
                <div class="col-md-6" id="divAddressTag" style="display: none;">
                    <input asp-for="AddressTag" class="form-control form-control-sm" placeholder="Tên nhãn địa chỉ (VD: Kho hàng 2, Shop Bình Thạnh...)" />
                </div>
            </div>

        </div>


        <!-- =========================
             2. THÔNG TIN NGƯỜI NHẬN
             ========================= -->

        <div class="order-section">

            <div class="order-section-header">
                <h2>2. Thông tin người nhận</h2>
                <p>Nhập thông tin người sẽ nhận hàng</p>
            </div>

            <div class="order-form-grid">

                <div class="form-group">

                    <label asp-for="ReceiverName"
                           class="form-label">
                        Họ và tên
                    </label>

                    <input asp-for="ReceiverName"
                           class="form-control"
                           placeholder="Nhập họ và tên người nhận" />

                    <span asp-validation-for="ReceiverName"
                          class="field-validation-error"></span>

                </div>


                <div class="form-group">

                    <label asp-for="ReceiverPhone"
                           class="form-label">
                        Số điện thoại
                    </label>

                    <input asp-for="ReceiverPhone"
                           class="form-control"
                           placeholder="Nhập số điện thoại" />

                    <span asp-validation-for="ReceiverPhone"
                          class="field-validation-error"></span>

                </div>

            </div>


            <div class="form-group">

                <label asp-for="ReceiverAddress"
                       class="form-label">
                    Địa chỉ nhận hàng
                </label>

                <input asp-for="ReceiverAddress"
                       class="form-control"
                       placeholder="Nhập địa chỉ người nhận" />

                <span asp-validation-for="ReceiverAddress"
                      class="field-validation-error"></span>

            </div>

        </div>


        <!-- =========================
             3. HÌNH THỨC GIAO HÀNG
             ========================= -->

        <div class="order-section">

            <div class="order-section-header">
                <h2>3. Hình thức giao hàng</h2>
                <p>Chọn hình thức giao hàng và nhập khoảng cách dự kiến.</p>
            </div>


            <div class="delivery-method-list">

                <!-- GIAO THƯỜNG -->

                <label class="delivery-method-option">

                    <input asp-for="DeliveryMethod"
                           type="radio"
                           value="Thường" />

                    <span>

                        <strong>Giao thường</strong>

                        <small>
                            Giao theo tuyến, chi phí thấp hơn
                        </small>

                    </span>

                </label>


                <!-- GIAO NHANH -->

                <label class="delivery-method-option">

                    <input asp-for="DeliveryMethod"
                           type="radio"
                           value="Nhanh" />

                    <span>

                        <strong>Giao nhanh</strong>

                        <small>
                            Giao riêng, thời gian nhanh hơn
                        </small>

                    </span>

                </label>

            </div>


            <span asp-validation-for="DeliveryMethod"
                  class="field-validation-error"></span>


            <!-- KHOẢNG CÁCH -->

            <div class="form-group mt-3">

                <label asp-for="DistanceKm"
                       class="form-label">
                    Khoảng cách dự kiến (km)
                </label>

                <input asp-for="DistanceKm"
                       id="distanceKm"
                       type="number"
                       class="form-control"
                       min="0.01"
                       max="100000"
                       step="0.01"
                       placeholder="Ví dụ: 7.5" />

                <small class="text-muted">
                    Khoảng cách tạm thời nhập thủ công để tính giá.
                </small>

                <span asp-validation-for="DistanceKm"
                      class="field-validation-error"></span>

            </div>

        </div>


        <!-- =========================
             4. THANH TOÁN
             ========================= -->

        <div class="order-section">

            <div class="order-section-header">

                <h2>4. Thanh toán</h2>

                <p>
                    Chọn phương thức thanh toán cho đơn hàng.
                </p>

            </div>


            <div class="payment-method-list">

                <!-- THANH TOÁN KHI GIAO -->

                <label class="payment-method-option">

                    <input asp-for="PaymentMethod"
                           type="radio"
                           value="Thanh toán khi giao hàng" />

                    <span>

                        <strong>
                            Thanh toán khi giao hàng
                        </strong>

                        <small>
                            Thanh toán khi hàng được giao
                        </small>

                    </span>

                </label>


                <!-- THANH TOÁN TRỰC TUYẾN -->

                <label class="payment-method-option">

                    <input asp-for="PaymentMethod"
                           type="radio"
                           value="Thanh toán trực tuyến" />

                    <span>

                        <strong>
                            Thanh toán trực tuyến
                        </strong>

                        <small>
                            Thanh toán trước khi hàng được giao
                        </small>

                    </span>

                </label>

            </div>


            <span asp-validation-for="PaymentMethod"
                  class="field-validation-error"></span>

        </div>


        <!-- =========================
             5. THÔNG TIN HÀNG HÓA
             ========================= -->

        <div class="order-section">

            <div class="order-section-header d-flex justify-content-between align-items-start">

                <div>

                    <h2>5. Thông tin hàng hóa</h2>

                    <p>
                        Có thể thêm nhiều loại hàng trong cùng một đơn
                    </p>

                </div>


                <button type="button"
                        id="btnAddItem"
                        class="btn btn-outline-primary btn-sm">
                    Thêm hàng hóa
                </button>

            </div>


            <div id="itemList"></div>

        </div>


        <!-- =========================
             6. TỔNG TIỀN
             ========================= -->

        <div class="order-section order-total-section">

            <div class="order-total-content">

                <div>

                    <h2>Tổng tiền</h2>

                    <p id="priceDescription">
                        Chọn hình thức giao hàng, nhập khoảng cách
                        và khối lượng để tính giá.
                    </p>

                </div>


                <div class="order-total-value"
                     id="totalPrice">
                    0 VNĐ
                </div>

            </div>

            <!-- BẢNG CHI TIẾT CƯỚC PHÍ LINH HOẠT -->
            <div id="fareBreakdownCard" class="fare-breakdown-card" style="display: none;">
                <div class="fare-breakdown-header">
                    <span><i class="bi bi-receipt-cutoff me-1 text-primary"></i> Chi tiết bảng tính cước:</span>
                    <span class="fare-live-badge"><i class="bi bi-broadcast"></i> Cập nhật Realtime</span>
                </div>
                <div class="fare-breakdown-body">
                    <div class="fare-row">
                        <div class="fare-label">
                            <i class="bi bi-truck text-secondary"></i>
                            <span>Cước vận chuyển cơ bản (<span id="bdDistanceText">0 km</span>)</span>
                        </div>
                        <div class="fare-amount" id="bdBaseFee">0 VNĐ</div>
                    </div>

                    <div class="fare-row" id="rowWeightFee">
                        <div class="fare-label">
                            <i class="bi bi-box-seam text-secondary"></i>
                            <span>Phụ phí vượt khối lượng (<span id="bdWeightText">0 kg</span>)</span>
                        </div>
                        <div class="fare-amount" id="bdWeightFee">0 VNĐ</div>
                    </div>

                    <div class="fare-row" id="rowWeatherFee">
                        <div class="fare-label">
                            <span id="bdWeatherIcon"><i class="bi bi-sun-fill text-warning"></i></span>
                            <span>Phụ thu thời tiết: <strong id="bdWeatherDesc">Bình thường</strong></span>
                        </div>
                        <div class="fare-amount" id="bdWeatherFee">+0 VNĐ</div>
                    </div>

                    <div class="fare-row" id="rowTrafficFee">
                        <div class="fare-label">
                            <span id="bdTrafficIcon"><i class="bi bi-car-front-fill text-primary"></i></span>
                            <span>Mật độ giao thông: <strong id="bdTrafficDesc">Bình thường</strong></span>
                        </div>
                        <div class="fare-amount" id="bdTrafficFee">+0 VNĐ</div>
                    </div>
                </div>
            </div>

        </div>


        <!-- =========================
             ACTION
             ========================= -->

        <div class="order-form-actions">

            <a asp-controller="Home"
               asp-action="Index"
               class="btn-cancel">
                Hủy
            </a>


            <button type="submit"
                    class="btn-submit-order">
                Tạo yêu cầu giao hàng
            </button>

        </div>

    </form>

    <!-- =========================
         POPUP XIN QUYỀN TRUY CẬP VỊ TRÍ
         ========================= -->
    <div id="geoConsentToast" class="geo-consent-toast" style="display: none;">
        <div class="geo-toast-content">
            <div class="geo-toast-icon">
                <i class="bi bi-geo-alt-fill"></i>
            </div>
            <div class="geo-toast-text">
                <strong>Cập nhật vị trí thời gian thực</strong>
                <p>Hệ thống dùng tọa độ để cập nhật thời tiết và mật độ giao thông tại chỗ, áp dụng biểu phí chính xác và điều phối nhanh nhất.</p>
            </div>
        </div>
        <div class="geo-toast-actions">
            <button type="button" class="btn-geo-dismiss" id="btnDismissGeo">Để sau</button>
            <button type="button" class="btn-geo-grant" id="btnGrantGeo">
                <i class="bi bi-check2-circle"></i> Cho phép
            </button>
        </div>
    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script>

        (function () {

            /* ==========================================
               DỮ LIỆU
               ========================================== */

            const packageTypes =
                @Html.Raw(
                    Json.Serialize(
                            packageTypes.Select(p => new
                            {
                                    id = p.PackageTypeId,
                                    name = p.TypeName
                            })
                    )
                        );


        const initialItems =
            @Html.Raw(
                                Json.Serialize(Model.Items)
                        );


        const list =
            document.getElementById('itemList');


        const distanceInput =
            document.getElementById('distanceKm');


        const totalPriceElement =
            document.getElementById('totalPrice');


        const priceDescriptionElement =
            document.getElementById('priceDescription');


        const btnAddItem =
            document.getElementById('btnAddItem');


        const senderLatInput =
            document.getElementById('senderLat');

        const senderLonInput =
            document.getElementById('senderLon');

        const senderAddressInput =
            document.getElementById('senderAddressInput');

        const locationBadge =
            document.getElementById('locationBadge');

        const locationBadgeText =
            document.getElementById('locationBadgeText');

        const btnLocateAddress =
            document.getElementById('btnLocateAddress');

        const geoToast =
            document.getElementById('geoConsentToast');

        const btnGrantGeo =
            document.getElementById('btnGrantGeo');

        const btnDismissGeo =
            document.getElementById('btnDismissGeo');

        const breakdownCard =
            document.getElementById('fareBreakdownCard');


        /* ==========================================
           ESC HTML
           ========================================== */

        function esc(value) {

            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');

        }


        /* ==========================================
           TÍNH TỔNG KHỐI LƯỢNG
           ========================================== */

        function calculateTotalWeight() {

            const rows =
                list.querySelectorAll('.item-row');


            let totalWeight = 0;


            rows.forEach(function (row) {

                const quantityInput =
                    row.querySelector('[name$=".Quantity"]');


                const weightInput =
                    row.querySelector('[name$=".Weight"]');


                const quantity =
                    parseFloat(
                        quantityInput?.value || '0'
                    );


                const weight =
                    parseFloat(
                        weightInput?.value || '0'
                    );


                if (
                    Number.isFinite(quantity) &&
                    Number.isFinite(weight) &&
                    quantity > 0 &&
                    weight > 0
                ) {

                    totalWeight +=
                        quantity * weight;

                }

            });


            return totalWeight;

        }


        /* ==========================================
           LẤY GIÁ TỪ DATABASE
           ========================================== */

        async function updatePrice() {

            const deliveryMethodInput =
                document.querySelector(
                    'input[name="DeliveryMethod"]:checked'
                );


            const deliveryMethod =
                deliveryMethodInput?.value || '';


            const distanceKm =
                parseFloat(
                    distanceInput?.value || '0'
                );


            const totalWeight =
                calculateTotalWeight();


            /* Chưa chọn hình thức */

            if (!deliveryMethod) {

                totalPriceElement.textContent =
                    '0 VNĐ';

                priceDescriptionElement.textContent =
                    'Vui lòng chọn hình thức giao hàng.';

                if (breakdownCard) {
                    breakdownCard.style.display = 'none';
                }

                return;

            }


            /* Chưa có khoảng cách */

            if (
                !Number.isFinite(distanceKm) ||
                distanceKm <= 0
            ) {

                totalPriceElement.textContent =
                    '0 VNĐ';

                priceDescriptionElement.textContent =
                    'Vui lòng nhập khoảng cách dự kiến.';

                if (breakdownCard) {
                    breakdownCard.style.display = 'none';
                }

                return;

            }


            /* Chưa có khối lượng */

            if (
                !Number.isFinite(totalWeight) ||
                totalWeight <= 0
            ) {

                totalPriceElement.textContent =
                    '0 VNĐ';

                priceDescriptionElement.textContent =
                    'Vui lòng nhập khối lượng hàng hóa.';

                if (breakdownCard) {
                    breakdownCard.style.display = 'none';
                }

                return;

            }


            /* Đang lấy giá */

            totalPriceElement.textContent =
                'Đang tính...';


            priceDescriptionElement.textContent =
                `Tổng khối lượng: ${totalWeight.toLocaleString('vi-VN')} kg | Khoảng cách: ${distanceKm.toLocaleString('vi-VN')} km`;


            try {

                const lat = senderLatInput ? senderLatInput.value : '';
                const lon = senderLonInput ? senderLonInput.value : '';

                let url =
                    '@Url.Action("CalculatePrice", "DeliveryOrder")' +
                    `?deliveryMethod=${encodeURIComponent(deliveryMethod)}` +
                    `&totalWeight=${encodeURIComponent(totalWeight)}` +
                    `&distanceKm=${encodeURIComponent(distanceKm)}`;

                if (lat && lon) {
                    url += `&lat=${encodeURIComponent(lat)}&lon=${encodeURIComponent(lon)}`;
                }


                const response =
                    await fetch(
                        url,
                        {
                            method: 'GET',
                            headers: {
                                'Accept': 'application/json'
                            }
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        'Không thể lấy dữ liệu bảng giá.'
                    );

                }


                const data =
                    await response.json();


                if (data.success) {

                    const price =
                        Number(data.price);


                    totalPriceElement.textContent =
                        price.toLocaleString('vi-VN') +
                        ' VNĐ';


                    priceDescriptionElement.textContent =
                        `Tổng khối lượng: ${totalWeight.toLocaleString('vi-VN')} kg | Khoảng cách: ${distanceKm.toLocaleString('vi-VN')} km`;


                    if (breakdownCard) {
                        breakdownCard.style.display = 'block';

                        const bdDist = document.getElementById('bdDistanceText');
                        if (bdDist) bdDist.textContent = `${distanceKm.toLocaleString('vi-VN')} km`;

                        const bdBase = document.getElementById('bdBaseFee');
                        if (bdBase) bdBase.textContent = (data.baseShippingFee || 0).toLocaleString('vi-VN') + ' VNĐ';

                        const bdWeight = document.getElementById('bdWeightText');
                        if (bdWeight) bdWeight.textContent = `${totalWeight.toLocaleString('vi-VN')} kg`;

                        const bdWeightFee = document.getElementById('bdWeightFee');
                        if (bdWeightFee) bdWeightFee.textContent = (data.weightFee || 0).toLocaleString('vi-VN') + ' VNĐ';

                        const weatherFee = data.weatherFee || 0;
                        const rowWeather = document.getElementById('rowWeatherFee');
                        const bdWeatherFee = document.getElementById('bdWeatherFee');
                        const bdWeatherDesc = document.getElementById('bdWeatherDesc');
                        const bdWeatherIcon = document.getElementById('bdWeatherIcon');

                        if (bdWeatherFee) {
                            bdWeatherFee.textContent = (weatherFee > 0 ? '+' : '') + weatherFee.toLocaleString('vi-VN') + ' VNĐ';
                        }
                        if (bdWeatherDesc) {
                            bdWeatherDesc.textContent = data.weatherDescription || 'Bình thường';
                        }
                        if (bdWeatherIcon) {
                            bdWeatherIcon.innerHTML = '<i class="' + (data.weatherIcon || 'bi bi-sun-fill text-warning') + '"></i>';
                        }
                        if (rowWeather) {
                            if (data.isWeatherSurchargeApplied) {
                                rowWeather.classList.add('surcharge-active');
                            } else {
                                rowWeather.classList.remove('surcharge-active');
                            }
                        }

                        const trafficFee = data.trafficFee || 0;
                        const rowTraffic = document.getElementById('rowTrafficFee');
                        const bdTrafficFee = document.getElementById('bdTrafficFee');
                        const bdTrafficDesc = document.getElementById('bdTrafficDesc');
                        const bdTrafficIcon = document.getElementById('bdTrafficIcon');

                        if (bdTrafficFee) {
                            bdTrafficFee.textContent = (trafficFee > 0 ? '+' : '') + trafficFee.toLocaleString('vi-VN') + ' VNĐ';
                        }
                        if (bdTrafficDesc) {
                            bdTrafficDesc.textContent = data.trafficDescription || 'Bình thường';
                        }
                        if (bdTrafficIcon) {
                            bdTrafficIcon.innerHTML = '<i class="' + (data.trafficIcon || 'bi bi-car-front-fill text-primary') + '"></i>';
                        }
                        if (rowTraffic) {
                            if (data.isTrafficSurchargeApplied) {
                                rowTraffic.classList.add('surcharge-active');
                            } else {
                                rowTraffic.classList.remove('surcharge-active');
                            }
                        }
                    }

                }
                else {

                    totalPriceElement.textContent =
                        'Chưa xác định';


                    priceDescriptionElement.textContent =
                        data.message ||
                        `Không có mức giá phù hợp cho ${totalWeight.toLocaleString('vi-VN')} kg và ${distanceKm.toLocaleString('vi-VN')} km trong bảng giá.`;

                    if (breakdownCard) {
                        breakdownCard.style.display = 'none';
                    }

                }

            }
            catch (error) {

                console.error(error);


                totalPriceElement.textContent =
                    'Không thể tính';


                priceDescriptionElement.textContent =
                    'Không thể lấy dữ liệu bảng giá.';

                if (breakdownCard) {
                    breakdownCard.style.display = 'none';
                }

            }

        }


        /* ==========================================
           THÊM DÒNG HÀNG HÓA
           ========================================== */

        function addRow(item) {

            item = item || {};


            const options =
                packageTypes
                    .map(function (p) {

                        const selected =
                            Number(p.id) ===
                            Number(item.packageTypeId)
                                ? 'selected'
                                : '';


                        return `
                            <option value="${p.id}" ${selected}>
                                ${esc(p.name)}
                            </option>
                        `;

                    })
                    .join('');


            const row =
                document.createElement('div');


            row.className =
                'item-row border rounded p-3 mb-3';


            row.innerHTML = `

                <!-- HEADER -->

                <div class="d-flex justify-content-between align-items-center mb-2">

                    <strong class="item-title">
                        Hàng hóa
                    </strong>

                    <button type="button"
                            class="btn btn-link text-danger p-0 btn-remove">
                        Xóa
                    </button>

                </div>


                <!-- LOẠI ĐÓNG GÓI + KÍCH THƯỚC -->

                <div class="order-form-grid">

                    <div class="form-group">

                        <label class="form-label">
                            Loại đóng gói
                        </label>

                        <select name="Items[0].PackageTypeId"
                                class="form-control"
                                required>

                            <option value="">
                                Chọn loại đóng gói
                            </option>

                            ${options}

                        </select>

                    </div>


                    <div class="form-group">

                        <label class="form-label">
                            Kích thước
                        </label>

                        <input type="text"
                               name="Items[0].Size"
                               class="form-control"
                               placeholder="Ví dụ: 30x20x15 cm"
                               value="${esc(item.size)}" />

                    </div>

                </div>


                <!-- MÔ TẢ -->

                <div class="form-group">

                    <label class="form-label">
                        Mô tả hàng hóa
                    </label>

                    <textarea name="Items[0].Description"
                              class="form-control"
                              rows="2"
                              placeholder="Mô tả hàng hóa cần giao">${esc(item.description)}</textarea>

                </div>


                <!-- SỐ LƯỢNG + KHỐI LƯỢNG -->

                <div class="order-form-grid">

                    <div class="form-group">

                        <label class="form-label">
                            Số lượng
                        </label>

                        <input type="number"
                               name="Items[0].Quantity"
                               min="1"
                               max="1000"
                               class="form-control"
                               required
                               value="${item.quantity || 1}" />

                    </div>


                    <div class="form-group">

                        <label class="form-label">
                            Khối lượng mỗi món (kg)
                        </label>

                        <input type="number"
                               name="Items[0].Weight"
                               min="0.01"
                               max="10000"
                               step="0.01"
                               class="form-control"
                               required
                               placeholder="Ví dụ: 2.5"
                               value="${item.weight || ''}" />

                    </div>

                </div>


                <!-- THUỘC TÍNH HÀNG -->

                <div class="order-checkbox-list">

                    <label class="order-checkbox">

                        <input type="checkbox"
                               name="Items[0].IsFragile"
                               value="true"
                               ${item.isFragile ? 'checked' : ''} />

                        <input type="hidden"
                               name="Items[0].IsFragile"
                               value="false" />

                        <span>
                            Hàng dễ vỡ
                        </span>

                    </label>


                    <label class="order-checkbox">

                        <input type="checkbox"
                               name="Items[0].IsValuable"
                               value="true"
                               ${item.isValuable ? 'checked' : ''} />

                        <input type="hidden"
                               name="Items[0].IsValuable"
                               value="false" />

                        <span>
                            Hàng có giá trị
                        </span>

                    </label>

                </div>

            `;


            /* ==========================================
               NÚT XÓA
               ========================================== */

            row.querySelector('.btn-remove')
                .addEventListener(
                    'click',
                    function () {

                        row.remove();

                        renumber();

                        updatePrice();

                    }
                );


            /* ==========================================
               INPUT THAY ĐỔI
               ========================================== */

            row.querySelectorAll(
                'input, select, textarea'
            ).forEach(
                function (input) {

                    input.addEventListener(
                        'input',
                        updatePrice
                    );


                    input.addEventListener(
                        'change',
                        updatePrice
                    );

                }
            );


            list.appendChild(row);

        }


        /* ==========================================
           ĐÁNH LẠI INDEX
           ========================================== */

        function renumber() {

            const rows =
                list.querySelectorAll('.item-row');


            rows.forEach(
                function (row, index) {

                    row.querySelector(
                        '.item-title'
                    ).textContent =
                        'Hàng hóa ' +
                        (index + 1);


                    row.querySelectorAll(
                        '[name]'
                    ).forEach(
                        function (element) {

                            element.name =
                                element.name.replace(
                                    /Items\[\d+\]/,
                                    'Items[' +
                                    index +
                                    ']'
                                );

                        }
                    );


                    const removeButton =
                        row.querySelector(
                            '.btn-remove'
                        );


                    if (rows.length > 1) {

                        removeButton.style.display =
                            '';

                    }
                    else {

                        removeButton.style.display =
                            'none';

                    }

                }
            );

        }


        /* ==========================================
           THÊM HÀNG
           ========================================== */

        btnAddItem.addEventListener(
            'click',
            function () {

                if (
                    list.children.length >= 20
                ) {

                    return;

                }


                addRow();

                renumber();

                updatePrice();

            }
        );


        /* ==========================================
           KHI ĐỔI HÌNH THỨC GIAO
           ========================================== */

        document.querySelectorAll(
            'input[name="DeliveryMethod"]'
        ).forEach(
            function (input) {

                input.addEventListener(
                    'change',
                    updatePrice
                );

            }
        );


        /* ==========================================
           KHI ĐỔI KHOẢNG CÁCH
           ========================================== */

        distanceInput.addEventListener(
            'input',
            updatePrice
        );


        distanceInput.addEventListener(
            'change',
            updatePrice
        );


        /* ==========================================
           KHỞI TẠO
           ========================================== */

        if (
            initialItems &&
            initialItems.length > 0
        ) {

            initialItems.forEach(
                function (item) {

                    addRow(item);

                }
            );

        }
        else {

            addRow();

        }


        renumber();


        updatePrice();


        /* ==========================================
           QUẢN LÝ VỊ TRÍ & POPUP XIN QUYỀN
           ========================================== */

        function requestUserLocation() {
            if (!navigator.geolocation) {
                alert('Trình duyệt của bạn không hỗ trợ định vị.');
                return;
            }

            if (locationBadge && locationBadgeText) {
                locationBadge.style.display = 'block';
                locationBadgeText.textContent = 'Đang lấy vị trí GPS...';
            }

            navigator.geolocation.getCurrentPosition(
                async function (pos) {
                    const lat = pos.coords.latitude;
                    const lon = pos.coords.longitude;

                    if (senderLatInput) senderLatInput.value = lat;
                    if (senderLonInput) senderLonInput.value = lon;
                    if (geoToast) geoToast.style.display = 'none';

                    if (locationBadge && locationBadgeText) {
                        locationBadge.style.display = 'block';
                        locationBadgeText.textContent = `Tọa độ: ${lat.toFixed(4)}, ${lon.toFixed(4)}`;
                    }

                    // Tự động điền địa chỉ nếu đang trống (sử dụng OpenStreetMap Nominatim miễn phí)
                    if (senderAddressInput && !senderAddressInput.value.trim()) {
                        try {
                            const revRes = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}`);
                            if (revRes.ok) {
                                const revData = await revRes.json();
                                if (revData && revData.display_name) {
                                    senderAddressInput.value = revData.display_name;
                                }
                            }
                        } catch (e) {
                            console.warn('Reverse geocoding error:', e);
                        }
                    }

                    // Tính lại giá với tọa độ thực tế
                    updatePrice();
                },
                function (err) {
                    console.warn('Geolocation error:', err);
                    if (geoToast) geoToast.style.display = 'none';
                    if (locationBadge && locationBadgeText) {
                        locationBadge.style.display = 'none';
                    }
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 }
            );
        }

        if (btnGrantGeo) {
            btnGrantGeo.addEventListener('click', function () {
                requestUserLocation();
            });
        }

        if (btnDismissGeo) {
            btnDismissGeo.addEventListener('click', function () {
                if (geoToast) geoToast.style.display = 'none';
                sessionStorage.setItem('geo_consent_dismissed', 'true');
            });
        }

        if (btnLocateAddress) {
            btnLocateAddress.addEventListener('click', function () {
                requestUserLocation();
            });
        }

        // Tự động hiện popup hỏi sau 800ms nếu chưa từ chối
        if (!sessionStorage.getItem('geo_consent_dismissed') && navigator.geolocation) {
            setTimeout(function () {
                if (geoToast && !senderLatInput?.value) {
                    geoToast.style.display = 'block';
                }
            }, 800);
        }

        /* ==========================================
           SỔ ĐỊA CHỈ NGƯỜI GỬI
           ========================================== */
        var selectSavedAddress = document.getElementById('selectSavedAddress');
        if (selectSavedAddress) {
            selectSavedAddress.addEventListener('change', function () {
                var selected = selectSavedAddress.options[selectSavedAddress.selectedIndex];
                if (selected && selected.value) {
                    var name = selected.getAttribute('data-name');
                    var phone = selected.getAttribute('data-phone');
                    var address = selected.getAttribute('data-address');

                    var nameInput = document.getElementById('SenderNameInput');
                    var phoneInput = document.getElementById('SenderPhoneInput');
                    var addressInput = document.getElementById('SenderAddressInput');

                    if (nameInput && name) nameInput.value = name;
                    if (phoneInput && phone) phoneInput.value = phone;
                    if (addressInput && address) addressInput.value = address;
                }
            });
        }

        var chkSaveAddress = document.getElementById('chkSaveAddress');
        var divAddressTag = document.getElementById('divAddressTag');
        if (chkSaveAddress && divAddressTag) {
            chkSaveAddress.addEventListener('change', function () {
                divAddressTag.style.display = chkSaveAddress.checked ? 'block' : 'none';
            });
        }

    })();

</script>
}