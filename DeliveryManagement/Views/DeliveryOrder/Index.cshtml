@model List<DeliveryManagement.Models.DeliveryOrder>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
    string selectedStatus = ViewBag.SelectedStatus as string ?? "";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-box-seam text-primary me-2"></i>Đơn Hàng Của Tôi</h2>
            <p class="text-muted mb-0">Theo dõi toàn bộ các yêu cầu giao hàng bạn đã tạo.</p>
        </div>
        <div>
            <a asp-controller="DeliveryOrder" asp-action="Create" class="btn btn-primary-custom shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Tạo đơn hàng mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- BỘ LỌC TRẠNG THÁI -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <div class="d-flex gap-2 flex-wrap">
                <a href="/DeliveryOrder" class="btn btn-sm @(string.IsNullOrEmpty(selectedStatus) ? "btn-primary-custom" : "btn-outline-secondary")">Tất cả</a>
                <a href="/DeliveryOrder?status=Chưa nhận" class="btn btn-sm @(selectedStatus == "Chưa nhận" ? "btn-primary-custom" : "btn-outline-secondary")">Chờ tiếp nhận</a>
                <a href="/DeliveryOrder?status=Trong kho" class="btn btn-sm @(selectedStatus == "Trong kho" ? "btn-primary-custom" : "btn-outline-secondary")">Trong kho</a>
                <a href="/DeliveryOrder?status=Đang giao" class="btn btn-sm @(selectedStatus == "Đang giao" ? "btn-primary-custom" : "btn-outline-secondary")">Đang giao</a>
                <a href="/DeliveryOrder?status=Đã giao" class="btn btn-sm @(selectedStatus == "Đã giao" ? "btn-primary-custom" : "btn-outline-secondary")">Hoàn tất</a>
                <a href="/DeliveryOrder?status=Đã hủy" class="btn btn-sm @(selectedStatus == "Đã hủy" ? "btn-primary-custom" : "btn-outline-secondary")">Đã hủy</a>
            </div>
        </div>
    </div>

    <!-- DANH SÁCH ĐƠN HÀNG -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                    <h5 class="text-muted">Chưa có đơn hàng nào trong mục này</h5>
                    <a asp-action="Create" class="btn btn-primary-custom mt-2">Tạo yêu cầu giao hàng ngay</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đơn</th>
                                <th>Người nhận</th>
                                <th>Địa chỉ nhận</th>
                                <th>Hình thức</th>
                                <th>Tổng tiền</th>
                                <th>Ngày tạo</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@order.OrderCode" class="fw-bold text-primary text-decoration-none">
                                            @order.OrderCode
                                        </a>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@order.ReceiverName</div>
                                        <small class="text-muted">@order.ReceiverPhone</small>
                                    </td>
                                    <td>
                                        <span class="d-inline-block text-truncate" style="max-width: 200px;" title="@order.ReceiverAddress">
                                            @order.ReceiverAddress
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(order.DeliveryMethod == "Nhanh" ? "bg-warning text-dark" : "bg-light text-dark border")">
                                            @order.DeliveryMethod
                                        </span>
                                    </td>
                                    <td class="fw-bold text-success">
                                        @order.TotalAmount.ToString("N0") đ
                                    </td>
                                    <td class="small text-muted">
                                        @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @{
                                            string badgeClass = order.CurrentStatus switch
                                            {
                                                "Chưa nhận" => "bg-secondary",
                                                "Đã nhận" or "Đã tiếp nhận" => "bg-info text-dark",
                                                "Trong kho" => "bg-primary",
                                                "Đang giao" => "bg-warning text-dark",
                                                "Đã giao" or "Giao thành công" => "bg-success",
                                                "Đã hủy" or "Giao thất bại" => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass">@order.CurrentStatus</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@order.OrderCode" class="btn btn-sm btn-outline-primary me-1" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (order.CurrentStatus == "Chưa nhận")
                                        {
                                            <form asp-action="Cancel" asp-route-id="@order.OrderCode" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng @order.OrderCode này?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Hủy đơn">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>
