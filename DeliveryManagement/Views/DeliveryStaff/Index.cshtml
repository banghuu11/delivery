@model List<DeliveryManagement.Models.DeliveryOrder>
@using System.Linq

@{
    ViewData["Title"] = "Quản lý đơn giao hàng";
    var orders = Model ?? new List<DeliveryManagement.Models.DeliveryOrder>();

    var deliveringCount = orders.Count(o => o.CurrentStatus == "Đã nhận – Đang giao");
    var deliveredCount = orders.Count(o => o.CurrentStatus == "Đã Giao");
    var failedCount = orders.Count(o => o.CurrentStatus == "Giao thất bại - Chờ xử lý");
}

<style>
    .delivery-page {
        color: #172033;
    }

    .delivery-hero {
        padding: 28px;
        border-radius: 20px;
        color: #fff;
        background: linear-gradient(120deg, #102a56, #1d4ed8);
        box-shadow: 0 12px 28px rgba(29, 78, 216, .15);
    }

        .delivery-hero h1 {
            font-weight: 800;
            letter-spacing: -.04em;
        }

    .delivery-stat {
        height: 100%;
        padding: 20px;
        background: #fff;
        border: 1px solid #e7ebf2;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, .04);
    }

    .delivery-stat-label {
        color: #64748b;
        font-size: .82rem;
        font-weight: 700;
    }

    .delivery-stat-value {
        margin-top: 6px;
        font-size: 1.8rem;
        font-weight: 800;
    }

    .delivery-panel {
        overflow: hidden;
        background: #fff;
        border: 1px solid #e7ebf2;
        border-radius: 18px;
        box-shadow: 0 6px 20px rgba(15, 23, 42, .04);
    }

    .delivery-panel-heading {
        padding: 20px 22px;
        border-bottom: 1px solid #e7ebf2;
    }

    .delivery-table {
        margin-bottom: 0;
    }

        .delivery-table thead th {
            padding: 14px 16px;
            color: #64748b;
            background: #f8fafc;
            border-bottom: 1px solid #e7ebf2;
            font-size: .76rem;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .delivery-table tbody td {
            padding: 16px;
            vertical-align: middle;
        }

        .delivery-table tbody tr:hover {
            background: #f8fbff;
        }

    .delivery-order-code {
        color: #1d4ed8;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .delivery-status {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: .76rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .status-delivering {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .status-delivered {
        color: #166534;
        background: #dcfce7;
    }

    .status-failed {
        color: #b91c1c;
        background: #fee2e2;
    }

    .status-ready {
        color: #92400e;
        background: #fef3c7;
    }

    .status-other {
        color: #334155;
        background: #e2e8f0;
    }

    .delivery-empty {
        padding: 55px 20px;
        color: #64748b;
        text-align: center;
    }

    .delivery-empty-icon {
        display: grid;
        width: 64px;
        height: 64px;
        margin: 0 auto 14px;
        place-items: center;
        color: #2563eb;
        background: #eff6ff;
        border-radius: 18px;
        font-size: 1.8rem;
    }

    @@media (max-width: 767.98px) {
        .delivery-hero {
            padding: 22px;
        }

        .delivery-panel-heading {
            padding: 16px;
        }

        .delivery-table tbody td {
            padding: 12px;
        }
    }
</style>

<div class="container py-4 delivery-page">

    <!-- TIÊU ĐỀ -->
    <div class="delivery-hero d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="small fw-bold text-uppercase opacity-75 mb-2">
                <i class="bi bi-truck me-2"></i>KHU VỰC NHÂN VIÊN GIAO HÀNG
            </div>

            <h1 class="mb-2">Đơn hàng được phân công</h1>

            <p class="mb-0 opacity-75">
                Chọn một đơn hàng để xem thông tin và ghi nhận kết quả giao.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-light rounded-pill px-4 fw-bold">
            <i class="bi bi-house-door me-1"></i>
            Trang chủ
        </a>
    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng"></button>
        </div>
    }

    <!-- THỐNG KÊ -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="delivery-stat">
                <div class="delivery-stat-label">Tổng đơn</div>
                <div class="delivery-stat-value">@orders.Count</div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="delivery-stat">
                <div class="delivery-stat-label">Đang giao</div>
                <div class="delivery-stat-value text-primary">@deliveringCount</div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="delivery-stat">
                <div class="delivery-stat-label">Đã giao thành công</div>
                <div class="delivery-stat-value text-success">@deliveredCount</div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="delivery-stat">
                <div class="delivery-stat-label">Giao thất bại</div>
                <div class="delivery-stat-value text-danger">@failedCount</div>
            </div>
        </div>
    </div>

    <!-- DANH SÁCH -->
    <section class="delivery-panel">

        <div class="delivery-panel-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="fw-bold mb-1">Danh sách đơn hàng</h5>
                <div class="small text-muted">
                    Danh sách chỉ gồm đơn được phân công cho tài khoản của bạn.
                </div>
            </div>

            <span class="badge rounded-pill text-bg-primary px-3 py-2">
                @orders.Count đơn
            </span>
        </div>

        @if (!orders.Any())
        {
            <div class="delivery-empty">
                <div class="delivery-empty-icon">
                    <i class="bi bi-inbox"></i>
                </div>

                <h5 class="fw-bold text-dark">Chưa có đơn được phân công</h5>

                <p class="mb-0">
                    Khi nhân viên kho phân công đơn cho bạn, đơn sẽ xuất hiện ở đây.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table delivery-table align-middle">
                    <thead>
                        <tr>
                            <th>Mã đơn hàng</th>
                            <th>Người nhận</th>
                            <th>Địa chỉ nhận</th>
                            <th>Hình thức</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var order in orders)
                        {
                            var statusClass =
                            order.CurrentStatus == "Đã nhận – Đang giao"
                            ? "status-delivering"
                            : order.CurrentStatus == "Đã Giao"
                            ? "status-delivered"
                            : order.CurrentStatus == "Giao thất bại - Chờ xử lý"
                            ? "status-failed"
                            : order.CurrentStatus == "Đã nhận - Chưa giao"
                            ? "status-ready"
                            : "status-other";

                            var statusLabel =
                            order.CurrentStatus == "Đã nhận – Đang giao"
                            ? "Đang giao"
                            : order.CurrentStatus == "Đã Giao"
                            ? "Đã giao"
                            : order.CurrentStatus == "Giao thất bại - Chờ xử lý"
                            ? "Giao thất bại"
                            : order.CurrentStatus;

                            <tr>
                                <td>
                                    <div class="delivery-order-code">
                                        @order.OrderCode
                                    </div>

                                    <div class="small text-muted mt-1">
                                        @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </td>

                                <td>
                                    <div class="fw-semibold">@order.ReceiverName</div>
                                    <div class="small text-muted">@order.ReceiverPhone</div>
                                </td>

                                <td style="min-width:220px;max-width:320px;">
                                    @order.ReceiverAddress
                                </td>

                                <td>@order.DeliveryMethod</td>

                                <td>
                                    <span class="delivery-status @statusClass">
                                        @statusLabel
                                    </span>
                                </td>

                                <td class="text-center">
                                    <a asp-controller="DeliveryStaff"
                                       asp-action="Details"
                                       asp-route-id="@order.OrderCode"
                                       class="btn btn-primary btn-sm rounded-pill px-3">
                                        <i class="bi bi-eye me-1"></i>
                                        Xem chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
