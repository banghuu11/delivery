@model DeliveryManagement.Models.DeliveryOrder
@using System.Linq
@using System.Globalization

@{
    ViewData["Title"] = "Chi tiết đơn giao hàng";

    var viCulture = new CultureInfo("vi-VN");
    var totalWeight = Model.OrderItems?.Sum(i => i.Weight * i.Quantity) ?? 0;

    var isDelivering = Model.CurrentStatus == "Đã nhận – Đang giao";
    var isDelivered = Model.CurrentStatus == "Đã Giao";
    var isFailed = Model.CurrentStatus == "Giao thất bại - Chờ xử lý";
}

<style>
    .detail-page {
        color: #172033;
    }

    .detail-hero {
        padding: 26px;
        border-radius: 20px;
        color: #fff;
        background: linear-gradient(120deg, #102a56, #1d4ed8);
        box-shadow: 0 12px 28px rgba(29, 78, 216, .15);
    }

        .detail-hero h1 {
            font-size: clamp(1.5rem, 3vw, 2rem);
            font-weight: 800;
            letter-spacing: -.035em;
            overflow-wrap: anywhere;
        }

    .detail-panel {
        height: 100%;
        overflow: hidden;
        background: #fff;
        border: 1px solid #e7ebf2;
        border-radius: 16px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .04);
    }

    .detail-panel-heading {
        padding: 16px 20px;
        background: #f8fafc;
        border-bottom: 1px solid #e7ebf2;
        font-weight: 800;
    }

    .detail-panel-body {
        padding: 20px;
    }

    .detail-label {
        margin-bottom: 5px;
        color: #64748b;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .035em;
    }

    .detail-value {
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .detail-status {
        display: inline-block;
        padding: 7px 12px;
        color: #1d4ed8;
        background: #dbeafe;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 800;
    }

    .detail-items th {
        background: #f8fafc;
        font-size: .8rem;
        white-space: nowrap;
    }

    .action-card {
        height: 100%;
        padding: 20px;
        border-radius: 14px;
    }

    .action-success {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
    }

    .action-failure {
        background: #fff7f7;
        border: 1px solid #fecaca;
    }

    .action-card .form-label {
        font-size: .86rem;
        font-weight: 700;
    }

    @@media (max-width: 767.98px) {
        .detail-hero {
            padding: 21px;
        }

        .detail-panel-body {
            padding: 16px;
        }
    }
</style>

<div class="container py-4 detail-page">

    <!-- QUAY LẠI DANH SÁCH -->
    <div class="mb-3">
        <a asp-controller="DeliveryStaff"
           asp-action="Index"
           class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại danh sách đơn
        </a>
    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng"></button>
        </div>
    }

    <!-- TIÊU ĐỀ ĐƠN -->
    <div class="detail-hero d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="small fw-bold text-uppercase opacity-75 mb-2">
                Chi tiết đơn giao hàng
            </div>

            <h1 class="mb-2">@Model.OrderCode</h1>

            <div class="opacity-75">
                Ngày tạo: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>

        <div>
            <div class="small opacity-75 mb-2">Trạng thái hiện tại</div>
            <span class="detail-status">@Model.CurrentStatus</span>
        </div>
    </div>

    <!-- NGƯỜI GỬI / NGƯỜI NHẬN -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-6">
            <section class="detail-panel">
                <div class="detail-panel-heading">
                    <i class="bi bi-person-up me-2 text-primary"></i>
                    Thông tin người gửi
                </div>

                <div class="detail-panel-body">
                    <div class="mb-3">
                        <div class="detail-label">Họ và tên</div>
                        <div class="detail-value">@Model.SenderName</div>
                    </div>

                    <div class="mb-3">
                        <div class="detail-label">Số điện thoại</div>
                        <div class="detail-value">@Model.SenderPhone</div>
                    </div>

                    <div>
                        <div class="detail-label">Địa chỉ gửi</div>
                        <div class="detail-value">@Model.SenderAddress</div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-12 col-lg-6">
            <section class="detail-panel">
                <div class="detail-panel-heading">
                    <i class="bi bi-person-check me-2 text-success"></i>
                    Thông tin người nhận
                </div>

                <div class="detail-panel-body">
                    <div class="mb-3">
                        <div class="detail-label">Họ và tên</div>
                        <div class="detail-value">@Model.ReceiverName</div>
                    </div>

                    <div class="mb-3">
                        <div class="detail-label">Số điện thoại</div>
                        <div class="detail-value">@Model.ReceiverPhone</div>
                    </div>

                    <div>
                        <div class="detail-label">Địa chỉ nhận</div>
                        <div class="detail-value">@Model.ReceiverAddress</div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <!-- KIỆN HÀNG -->
    <section class="detail-panel mb-4">
        <div class="detail-panel-heading">
            <i class="bi bi-box-seam me-2 text-primary"></i>
            Thông tin kiện hàng
        </div>

        <div class="table-responsive">
            <table class="table table-bordered detail-items align-middle mb-0">
                <thead>
                    <tr>
                        <th class="text-center">STT</th>
                        <th>Mô tả</th>
                        <th>Loại bao gói</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Khối lượng</th>
                        <th>Cảnh báo</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.OrderItems != null && Model.OrderItems.Any())
                    {
                        var stt = 1;

                        foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td class="text-center">@stt</td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Description)
                                                                ? "Bưu phẩm / Bưu kiện"
                                                                : item.Description)
                        </td>

                                <td>
                                    @(item.PackageType?.TypeName ?? "Gói tiêu chuẩn")
                                </td>

                                <td class="text-center">@item.Quantity</td>

                                <td class="text-end">
                                    @item.Weight.ToString("0.##") kg
                                </td>

                                <td>
                            @if (item.IsFragile)
                                    {
                                        <span class="badge text-bg-danger me-1">Dễ vỡ</span>
                                    }

                                    @if (item.IsValuable)
                                    {
                                        <span class="badge text-bg-warning">Giá trị cao</span>
                                    }

                                    @if (!item.IsFragile && !item.IsValuable)
                                    {
                                        <span class="badge text-bg-light border text-secondary">
                                            Hàng thường
                                        </span>
                                    }
                                </td>
                            </tr>

                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                Không có thông tin kiện hàng.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="detail-panel-body">
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <div class="detail-label">Hình thức giao</div>
                    <div class="detail-value">@Model.DeliveryMethod</div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="detail-label">Tổng khối lượng</div>
                    <div class="detail-value">@totalWeight.ToString("0.##") kg</div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="detail-label">Khoảng cách</div>
                    <div class="detail-value">@Model.DistanceKm km</div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="detail-label">Tổng cước</div>
                    <div class="detail-value text-primary">
                        @Model.TotalAmount.ToString("N0", viCulture) đ
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CHỈ HIỆN FORM KHI ĐƠN ĐANG GIAO -->
    @if (isDelivering)
    {
        <div class="mb-3">
            <h4 class="fw-bold mb-1">Cập nhật kết quả giao hàng</h4>
            <p class="text-muted mb-0">
                Chỉ xác nhận kết quả sau khi đã thực hiện giao hàng thực tế.
            </p>
        </div>

        <div class="row g-3 mb-4">

            <!-- GIAO THÀNH CÔNG -->
            <div class="col-12 col-lg-6">
                <section class="action-card action-success">
                    <h5 class="fw-bold text-success mb-3">
                        <i class="bi bi-check-circle me-2"></i>
                        Giao hàng thành công
                    </h5>

                    <form asp-controller="DeliveryStaff"
                          asp-action="CompleteDelivery"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.OrderCode" />

                        <div class="mb-3">
                            <label class="form-label">
                                Ảnh minh chứng <span class="text-danger">*</span>
                            </label>

                            <input type="file"
                                   name="proofImage"
                                   class="form-control"
                                   accept=".jpg,.jpeg,image/jpeg"
                                   required />

                            <div class="form-text">
                                Chỉ nhận JPG/JPEG, dung lượng tối đa 2 MB.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ghi chú giao hàng</label>

                            <textarea name="deliveryNote"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500"
                                  placeholder="Nhập ghi chú nếu có..."></textarea>
                        </div>

                        <button type="submit"
                                class="btn btn-success w-100"
                                onclick="return confirm('Xác nhận đơn hàng đã được giao thành công?');">
                            <i class="bi bi-check-circle me-1"></i>
                            Xác nhận đã giao
                        </button>
                    </form>
                </section>
            </div>

            <!-- GIAO THẤT BẠI -->
            <div class="col-12 col-lg-6">
                <section class="action-card action-failure">
                    <h5 class="fw-bold text-danger mb-3">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Giao hàng thất bại
                    </h5>

                    <form asp-controller="DeliveryStaff"
                          asp-action="FailDelivery"
                          method="post"
                          class="failure-form">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.OrderCode" />

                        <div class="mb-3">
                            <label class="form-label">
                                Lý do thất bại <span class="text-danger">*</span>
                            </label>

                            <select name="failureReason"
                                    class="form-select failure-reason"
                                    required>
                                <option value="">-- Chọn lý do --</option>
                                <option value="Không liên lạc được với người nhận">
                                    Không liên lạc được với người nhận
                                </option>
                                <option value="Sai địa chỉ">Sai địa chỉ</option>
                                <option value="Khách từ chối nhận">
                                    Khách từ chối nhận
                                </option>
                                <option value="Lý do khác">Lý do khác</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ghi chú / mô tả</label>

                            <textarea name="deliveryNote"
                                  class="form-control failure-note"
                                  rows="3"
                                  maxlength="500"
                                  placeholder="Mô tả tình huống giao hàng..."></textarea>

                            <div class="form-text failure-note-help">
                                Nếu chọn “Lý do khác”, bắt buộc nhập ghi chú.
                            </div>
                        </div>

                        <button type="submit"
                                class="btn btn-outline-danger w-100"
                                onclick="return confirm('Xác nhận giao hàng thất bại? Đơn sẽ chuyển sang chờ kho xử lý.');">
                            <i class="bi bi-exclamation-circle me-1"></i>
                            Ghi nhận giao thất bại
                        </button>
                    </form>
                </section>
            </div>
        </div>
    }
    else if (isDelivered)
    {
        <div class="alert alert-success rounded-4 p-4">
            <h5 class="fw-bold">
                <i class="bi bi-check-circle-fill me-2"></i>
                Đơn hàng đã giao thành công
            </h5>

            <p class="mb-2">
                Đơn đã hoàn tất, không thể ghi nhận kết quả lần nữa.
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.ProofImage))
            {
                <a href="@Model.ProofImage"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-outline-success btn-sm">
                    <i class="bi bi-image me-1"></i>
                    Xem ảnh minh chứng
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(Model.DeliveryNote))
            {
                <div class="mt-3">
                    <strong>Ghi chú:</strong>
                    <div style="white-space:pre-line">@Model.DeliveryNote</div>
                </div>
            }
        </div>
    }
    else if (isFailed)
    {
        <div class="alert alert-danger rounded-4 p-4">
            <h5 class="fw-bold">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Giao thất bại — chờ kho xử lý
            </h5>

            <p class="mb-2">
                Đơn đã được chuyển về kho. Shipper không thể tự giao lại từ trang này.
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.DeliveryResult))
            {
                <div>
                    <strong>Kết quả:</strong>
                    @Model.DeliveryResult
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.DeliveryNote))
            {
                <div class="mt-2">
                    <strong>Ghi chú:</strong>
                    <div style="white-space:pre-line">@Model.DeliveryNote</div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info rounded-4 p-4">
            <h5 class="fw-bold mb-2">
                <i class="bi bi-info-circle me-2"></i>
                Chưa có thao tác giao hàng
            </h5>

            <p class="mb-0">
                Trạng thái hiện tại là <strong>@Model.CurrentStatus</strong>.
                Các thao tác ghi nhận chỉ khả dụng khi đơn ở trạng thái
                <strong>Đã nhận – Đang giao</strong>.
            </p>
        </div>
    }

    <div class="text-center mt-4">
        <a asp-controller="DeliveryStaff"
           asp-action="Index"
           class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại danh sách đơn
        </a>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.failure-form').forEach(function (form) {
            const select = form.querySelector('.failure-reason');
            const note = form.querySelector('.failure-note');
            const help = form.querySelector('.failure-note-help');

            function updateFailureNote() {
                const needsNote = select.value === 'Lý do khác';

                note.required = needsNote;

                help.textContent = needsNote
                    ? 'Bắt buộc nhập ghi chú khi chọn "Lý do khác".'
                    : 'Có thể nhập thêm thông tin để nhân viên xử lý.';
            }

            select.addEventListener('change', updateFailureNote);
            updateFailureNote();
        });
    </script>
}
