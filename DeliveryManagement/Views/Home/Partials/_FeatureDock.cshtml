@model List<DeliveryManagement.Models.HomeFeature>

<div class="tocdo-dock-container container">
    <div class="tocdo-floating-card shadow-lg">
        <div class="row g-0 align-items-center">
            
            @if (Model != null && Model.Any())
            {
                int total = Model.Count;
                int idx = 0;
                @foreach (var feature in Model)
                {
                    bool isMiddle = idx == 1 && total > 2;
                    <div class="col-md-@(12 / (total > 0 ? total : 3)) dock-item @(isMiddle ? "border-start-md border-end-md" : "")">
                        <div class="d-flex flex-column align-items-center text-center p-4">
                            <div class="dock-icon-wrapper mb-3">
                                <div class="dock-3d-badge bg-orange-soft">
                                    <i class="bi @feature.IconClass text-orange fs-1"></i>
                                </div>
                            </div>
                            <h5 class="dock-title fw-bold mb-1">@feature.Title</h5>
                            <p class="dock-desc text-muted small mb-0">@feature.Description</p>
                        </div>
                    </div>
                    idx++;
                }
            }
            else
            {
                <div class="col-12 p-4 text-center text-muted">
                    Hệ thống đang đồng bộ dữ liệu tính năng...
                </div>
            }

        </div>
    </div>
</div>
