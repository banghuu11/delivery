<div class="tocdo-dock-container container">
    <div class="tocdo-floating-card shadow-lg">
        <div class="row g-0 align-items-center">
            
            <!-- MỤC 1: GIAO HÀNG HỎA TỐC -->
            <div class="col-md-4 dock-item">
                <div class="d-flex flex-column align-items-center text-center p-4">
                    <div class="dock-icon-wrapper mb-3">
                        <div class="dock-3d-badge bg-orange-soft">
                            <i class="bi bi-bicycle text-orange fs-1"></i>
                        </div>
                    </div>
                    <h5 class="dock-title fw-bold mb-1">Giao Hàng Hỏa Tốc</h5>
                    <p class="dock-desc text-muted small mb-0">Nội thành từ 1 - 3 giờ, ưu tiên lấy ngay</p>
                </div>
            </div>

            <!-- MỤC 2: VẬN CHUYỂN TOÀN QUỐC -->
            <div class="col-md-4 dock-item border-start-md border-end-md">
                <div class="d-flex flex-column align-items-center text-center p-4">
                    <div class="dock-icon-wrapper mb-3">
                        <div class="dock-3d-badge bg-orange-soft">
                            <i class="bi bi-truck text-orange fs-1"></i>
                        </div>
                    </div>
                    <h5 class="dock-title fw-bold mb-1">Vận Chuyển Toàn Quốc</h5>
                    <p class="dock-desc text-muted small mb-0">Liên tỉnh an toàn, cước phí tối ưu</p>
                </div>
            </div>

            <!-- MỤC 3: THEO DÕI THỜI GIAN THỰC -->
            <div class="col-md-4 dock-item">
                <div class="d-flex flex-column align-items-center text-center p-4">
                    <div class="dock-icon-wrapper mb-3">
                        <div class="dock-3d-badge bg-orange-soft">
                            <i class="bi bi-stopwatch text-orange fs-1"></i>
                        </div>
                    </div>
                    <h5 class="dock-title fw-bold mb-1">Theo Dõi Thời Gian Thực</h5>
                    <p class="dock-desc text-muted small mb-0">Cập nhật lộ trình và check-in chính xác</p>
                </div>
            </div>

        </div>
    </div>
</div>
