@model DeliveryManagement.Models.WebsiteSetting
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    string bannerBgUrl = !string.IsNullOrWhiteSpace(Model?.HeroBannerImageUrl) && Model.HeroBannerImageUrl != "/images/hero_courier.jpg" 
        ? Model.HeroBannerImageUrl 
        : "/images/hero_banner_exact.jpg";
}

<section class="tocdo-hero-panoramic" style="background-image: url('@bannerBgUrl');">
    <div class="container position-relative z-2">
        <div class="row align-items-center min-vh-hero-panoramic">
            
            <!-- CỘT TRÁI: TIÊU ĐỀ, SLOGAN & NÚT HÀNH ĐỘNG KHỚP 100% MOCKUP -->
            <div class="col-lg-7 col-md-8 hero-text-col">
                <h1 class="tocdo-hero-title text-uppercase fw-900 text-white mb-2">
                    @(string.IsNullOrWhiteSpace(Model?.Slogan) ? "GIAO HÀNG HỎA TỐC, NHẬN TRONG NGÀY" : Model.Slogan)
                </h1>

                <p class="tocdo-hero-subtitle text-white mb-4">
                    @(string.IsNullOrWhiteSpace(Model?.SubSlogan) ? "An Toàn - Nhanh Chóng - Tin Cậy" : Model.SubSlogan)
                </p>

                <div class="tocdo-hero-actions">
                    @if (isAuthenticated)
                    {
                        @if (User.IsInRole("Customer"))
                        {
                            <a asp-controller="DeliveryOrder" asp-action="Create" class="btn btn-tocdo-hero-btn shadow">
                                Gửi Đơn Ngay
                            </a>
                        }
                        else if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin" asp-action="Index" class="btn btn-tocdo-hero-btn shadow">
                                Bảng Điều Khiển Admin
                            </a>
                        }
                        else if (User.IsInRole("ReceptionStaff"))
                        {
                            <a asp-controller="Reception" asp-action="Index" class="btn btn-tocdo-hero-btn shadow">
                                Tiếp Nhận Đơn Hàng
                            </a>
                        }
                        else if (User.IsInRole("WarehouseStaff"))
                        {
                            <a asp-controller="Warehouse" asp-action="Index" class="btn btn-tocdo-hero-btn shadow">
                                Quản Lý Kho
                            </a>
                        }
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-tocdo-hero-btn shadow">
                            Gửi Đơn Ngay
                        </a>
                    }
                </div>
            </div>

            <!-- CỘT PHẢI ĐỂ TRỐNG ĐỂ LỘ HÌNH SHIPPER VÀ CẢNH THÀNH PHỐ TRONG NỀN -->
            <div class="col-lg-5 col-md-4"></div>

        </div>
    </div>
</section>
