@{
    ViewData["Title"] = "Vị trí shipper - " + (string)ViewBag.OrderCode;
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-1">Vị trí shipper</h2>
            <p class="text-muted mb-0">
                Đơn <strong>@ViewBag.OrderCode</strong> &middot; @ViewBag.Status
            </p>
        </div>

        @if (User.IsInRole("WarehouseStaff"))
        {
            <a asp-controller="Tracking" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-map me-1"></i>Tất cả shipper đang giao
            </a>
        }
    </div>

    <partial name="_ShipperMap" model="(string)ViewBag.OrderCode" />
</div>
