@model List<DeliveryManagement.Models.DeliveryOrder>

@using System.Linq

@{
    ViewData["Title"] = "Quản lý kho";

    var orders = Model ?? new List<DeliveryManagement.Models.DeliveryOrder>();

    var totalOrders = orders.Count;

    var waitingOrders = orders.Count(
        o => o.CurrentStatus == "Đã nhận - Chưa giao");

    var expressMethods = new[]
    {
        "Nhanh",
        "Giao hỏa tốc",
        "Giao siêu tốc 2h"
    };

    var normalMethods = new[]
    {
        "Thường",
        "Giao tiêu chuẩn",
        "Giao tiết kiệm"
    };
}

<div class="container mt-4 mb-5">

    <!-- TIÊU ĐỀ -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="mb-1">Quản lý kho</h2>

            <p class="text-muted mb-0">
                Theo dõi đơn hàng đã tiếp nhận, điều phối đơn giao nhanh
                và xử lý đơn giao thất bại.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">

            <a asp-controller="Warehouse"
               asp-action="Dispatch"
               class="btn btn-primary">

                <i class="bi bi-truck me-1"></i>
                Điều phối đơn giao nhanh

            </a>

            <a asp-controller="Warehouse"
               asp-action="FailedDeliveries"
               class="btn btn-outline-danger">

                <i class="bi bi-exclamation-triangle me-1"></i>
                Xử lý đơn giao thất bại

            </a>

        </div>

    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-1"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-circle me-1"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng">
            </button>

        </div>
    }

    <!-- THỐNG KÊ -->
    <div class="row g-3 mb-4">

        <div class="col-md-6">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <div class="text-muted small">
                            Tổng đơn đã tiếp nhận
                        </div>

                        <div class="fs-3 fw-bold">
                            @totalOrders
                        </div>
                    </div>

                    <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                        <i class="bi bi-box-seam text-primary fs-3"></i>
                    </div>

                </div>
            </div>

        </div>

        <div class="col-md-6">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <div class="text-muted small">
                            Đơn đang chờ xử lý
                        </div>

                        <div class="fs-3 fw-bold text-warning">
                            @waitingOrders
                        </div>
                    </div>

                    <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                        <i class="bi bi-clock-history text-warning fs-3"></i>
                    </div>

                </div>
            </div>

        </div>

    </div>

    <!-- HƯỚNG DẪN QUY TRÌNH -->
    <div class="alert alert-info">

        <div class="fw-semibold mb-1">
            <i class="bi bi-info-circle me-1"></i>
            Quy trình xử lý đơn hàng
        </div>

        <ul class="mb-0">

            <li>
                Đơn giao thường: nhân viên giao hàng chủ động nhận giao.
            </li>

            <li>
                Đơn giao nhanh: nhân viên kho phân công shipper
                tại mục Điều phối đơn giao nhanh.
            </li>

            <li>
                Nhân viên kho không cần thực hiện bước phân loại hàng hóa.
            </li>

        </ul>

    </div>

    <!-- DANH SÁCH ĐƠN HÀNG -->
    @if (!orders.Any())
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <i class="bi bi-inbox fs-1 text-muted"></i>

                <h5 class="mt-3">
                    Chưa có đơn hàng
                </h5>

                <p class="text-muted mb-0">
                    Các đơn hàng đã được nhân viên tiếp nhận ghi nhận
                    sẽ xuất hiện tại đây.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white py-3">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                    <h5 class="mb-0">
                        <i class="bi bi-list-ul me-2"></i>
                        Danh sách đơn hàng trong kho
                    </h5>

                    <span class="badge bg-primary">
                        @totalOrders đơn
                    </span>

                </div>

            </div>

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Mã đơn</th>
                                <th>Hình thức giao</th>
                                <th>Khối lượng</th>
                                <th>Trạng thái</th>
                                <th>Ngày tạo</th>
                                <th>Ngày tiếp nhận</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var order in orders)
                            {
                                var totalWeight =
                                order.OrderItems?.Sum(
                                i => i.Weight * i.Quantity) ?? 0m;

                                var method =
                                order.DeliveryMethod?.Trim() ?? string.Empty;

                                var isExpress =
                                expressMethods.Contains(method);

                                var isNormal =
                                normalMethods.Contains(method);

                                <tr>

                                    <!-- MÃ ĐƠN -->
                                    <td>
                                        <strong>
                                            @order.OrderCode
                                        </strong>
                                    </td>

                                    <!-- HÌNH THỨC GIAO -->
                                    <td>

                                        @if (isExpress)
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-lightning-fill me-1"></i>
                                                @method
                                            </span>
                                        }
                                        else if (isNormal)
                                        {
                                            <span class="badge bg-info text-dark">
                                                <i class="bi bi-truck me-1"></i>
                                                @method
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @(string.IsNullOrWhiteSpace(method)
                                                                                    ? "Chưa xác định"
                                                                                    : method)
                                </span>
                                                                }

                                    </td>

                                    <!-- KHỐI LƯỢNG -->
                                    <td>
                                        @totalWeight.ToString("0.##") kg
                                    </td>

                                    <!-- TRẠNG THÁI -->
                                    <td>

                                        @if (order.CurrentStatus == "Đã Giao")
                                        {
                                            <span class="badge bg-success">
                                                @order.CurrentStatus
                                            </span>
                                        }
                                        else if (order.CurrentStatus == "Giao thất bại - Chờ xử lý")
                                        {
                                            <span class="badge bg-danger">
                                                @order.CurrentStatus
                                            </span>
                                        }
                                        else if (order.CurrentStatus == "Chờ hoàn hàng")
                                        {
                                            <span class="badge bg-dark">
                                                @order.CurrentStatus
                                            </span>
                                        }
                                        else if (order.CurrentStatus == "Đã nhận – Đang giao")
                                        {
                                            <span class="badge bg-primary">
                                                @order.CurrentStatus
                                            </span>
                                        }
                                        else if (order.CurrentStatus == "Đã nhận - Chưa giao")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @order.CurrentStatus
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @order.CurrentStatus
                                            </span>
                                        }

                                    </td>

                                    <!-- NGÀY TẠO -->
                                    <td>
                                        @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <!-- NGÀY TIẾP NHẬN -->
                                    <td>

                                        @if (order.ReceivedAt.HasValue)
                                        {
                                            @order.ReceivedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Chưa tiếp nhận
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>
