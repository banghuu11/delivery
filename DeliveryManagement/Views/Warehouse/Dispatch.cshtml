@model List<DeliveryManagement.Models.DeliveryOrder>
@using DeliveryManagement.Models

@{
    ViewData["Title"] = "Điều phối đơn giao nhanh";

    var deliveryStaffs =
        ViewBag.DeliveryStaffs as IList<ApplicationUser>
        ?? new List<ApplicationUser>();
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center
                flex-wrap gap-3 mb-4">
        <div>
            <h2 class="mb-1">Điều phối đơn giao nhanh</h2>
            <p class="text-muted mb-0">
                Phân công nhân viên giao hàng cho các đơn giao nhanh
                chưa có người phụ trách.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại quản lý kho
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="alert alert-info">
        <strong>Quy tắc điều phối:</strong>
        Đơn giao nhanh do nhân viên điều phối phân công.
        Đơn giao thường sẽ được đưa vào danh sách để shipper tự nhận.
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <h5 class="mt-3">Chưa có đơn giao nhanh cần phân công</h5>
                <p class="text-muted mb-0">
                    Các đơn giao nhanh đủ điều kiện sẽ hiển thị tại đây.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đơn</th>
                                <th>Người nhận</th>
                                <th>Địa chỉ nhận</th>
                                <th>Khoảng cách</th>
                                <th>Cước phí</th>
                                <th>Ngày tạo</th>
                                <th style="min-width: 260px">
                                    Phân công shipper
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@order.OrderCode</strong>
                                        <div class="mt-1">
                                            <span class="badge bg-warning text-dark">
                                                Giao nhanh
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        @order.ReceiverName
                                        <div class="small text-muted">
                                            @order.ReceiverPhone
                                        </div>
                                    </td>

                                    <td>@order.ReceiverAddress</td>

                                    <td>
                                        @order.DistanceKm.ToString("0.##") km
                                    </td>

                                    <td>
                                        @order.TotalAmount.ToString("N0") đ
                                    </td>

                                    <td>
                                        @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @if (deliveryStaffs.Count == 0)
                                        {
                                            <span class="text-danger small">
                                                Chưa có tài khoản shipper.
                                                Hãy tạo tài khoản có vai trò
                                                DeliveryStaff trong trang Admin.
                                            </span>
                                        }
                                        else
                                        {
                                            <form asp-action="AssignExpressOrder"
                                                  method="post">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@order.OrderCode" />

                                                <div class="input-group">
                                                    <select name="deliveryStaffId"
                                                            class="form-select"
                                                            required>
                                                        <option value="">
                                                            -- Chọn shipper --
                                                        </option>

                                                        @foreach (var staff in deliveryStaffs)
                                                        {
                                                            <option value="@staff.Id">
                                                                @staff.FullName
                                                                (@staff.Email)
                                                            </option>
                                                        }
                                                    </select>

                                                    <button type="submit"
                                                            class="btn btn-primary">
                                                        Phân công
                                                    </button>
                                                </div>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    }

</div>
