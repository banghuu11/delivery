@model List<DeliveryManagement.Models.DeliveryOrder>
@using System.Collections.Generic
@using System.Linq
@using DeliveryManagement.Models

@{
    ViewData["Title"] = "Phân công đơn giao hàng";

    var orders = Model ?? new List<DeliveryOrder>();

    var deliveryStaffs =
        ViewBag.DeliveryStaffs as IList<ApplicationUser>
        ?? new List<ApplicationUser>();
}

<div class="container mt-4 mb-5">

    <!-- TIÊU ĐỀ -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="mb-1">Phân công đơn giao hàng</h2>
            <p class="text-muted mb-0">
                Kho phân công nhân viên giao hàng cho các đơn đã được tiếp nhận
                và chưa có người phụ trách.
            </p>
        </div>

        <a asp-controller="Warehouse"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại quản lý kho
        </a>
    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng"></button>
        </div>
    }

   

    <!-- THỐNG KÊ -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Đơn chờ phân công</div>
                    <div class="fs-3 fw-bold">@orders.Count</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Nhân viên giao hàng</div>
                    <div class="fs-3 fw-bold">@deliveryStaffs.Count</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Hình thức giao</div>
                    <div class="fs-5 fw-bold">Nhanh</div>
                </div>
            </div>
        </div>
    </div>

    <!-- CHƯA CÓ SHIPPER -->
    @if (orders.Any() && deliveryStaffs.Count == 0)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-1"></i>
            Hiện chưa có tài khoản nào mang vai trò
            <strong>DeliveryStaff</strong>. Hãy tạo hoặc cấp đúng vai trò
            cho tài khoản nhân viên giao hàng trước khi phân công.
        </div>
    }

    <!-- DANH SÁCH ĐƠN CHỜ PHÂN CÔNG -->
    @if (!orders.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted"></i>

                <h5 class="mt-3">
                    Không có đơn hàng chờ phân công
                </h5>

                <p class="text-muted mb-0">
                    Các đơn đã được tiếp nhận và chưa có nhân viên phụ trách
                    sẽ xuất hiện tại đây.
                </p>

                <a asp-controller="Warehouse"
                   asp-action="Index"
                   class="btn btn-outline-primary mt-3">
                    Xem danh sách đơn hàng
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">Danh sách đơn chờ phân công</h5>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đơn</th>
                                <th>Người nhận</th>
                                <th>Địa chỉ nhận</th>
                                <th>Hình thức</th>
                                <th>Khoảng cách</th>
                                <th>Cước phí</th>
                                <th>Ngày tạo</th>
                                <th style="min-width: 280px">
                                    Phân công shipper
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var order in orders)
                            {
                                <tr>
                                    <!-- MÃ ĐƠN -->
                                    <td>
                                        <strong>@order.OrderCode</strong>

                                        <div class="small mt-1">
                                            <span class="badge bg-warning text-dark">
                                                Chờ phân công
                                            </span>
                                        </div>
                                    </td>

                                    <!-- NGƯỜI NHẬN -->
                                    <td>
                                        <div class="fw-semibold">
                                            @order.ReceiverName
                                        </div>

                                        <div class="small text-muted">
                                            @order.ReceiverPhone
                                        </div>
                                    </td>

                                    <!-- ĐỊA CHỈ -->
                                    <td>
                                        @order.ReceiverAddress
                                    </td>

                                    <!-- HÌNH THỨC GIAO -->
                                    <td>
                                        @if (order.DeliveryMethod == "Nhanh")
                                        {
                                            <span class="badge bg-danger">
                                                Giao nhanh
                                            </span>
                                        }
                                        else if (order.DeliveryMethod == "Thường")
                                        {
                                            <span class="badge bg-primary">
                                                Giao thường
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @order.DeliveryMethod
                                            </span>
                                        }
                                    </td>

                                    <!-- KHOẢNG CÁCH -->
                                    <td>
                                        @order.DistanceKm.ToString("0.##") km
                                    </td>

                                    <!-- CƯỚC PHÍ -->
                                    <td>
                                        @order.TotalAmount.ToString("N0") đ
                                    </td>

                                    <!-- NGÀY TẠO -->
                                    <td>
                                        @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <!-- FORM PHÂN CÔNG -->
                                    <td>
                                        @if (deliveryStaffs.Count == 0)
                                        {
                                            <span class="text-danger small">
                                                Chưa có nhân viên giao hàng.
                                            </span>
                                        }
                                        else
                                        {
                                            <form asp-controller="Warehouse"
                                                  asp-action="AssignExpressOrder"
                                                  method="post"
                                                  class="dispatch-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@order.OrderCode" />

                                                <label class="form-label small">
                                                    Chọn nhân viên
                                                </label>

                                                <select name="deliveryStaffId"
                                                        class="form-select form-select-sm mb-2"
                                                        required>
                                                    <option value="">
                                                        -- Chọn shipper --
                                                    </option>

                                                    @foreach (var staff in deliveryStaffs)
                                                    {
                                                        <option value="@staff.Id">
                                                            @staff.FullName (@staff.Email)
                                                        </option>
                                                    }
                                                </select>

                                                <button type="submit"
                                                        class="btn btn-primary btn-sm w-100"
                                                        onclick="return confirm('Phân công đơn @order.OrderCode cho nhân viên được chọn? Đơn sẽ chuyển sang trạng thái đang giao.');">
                                                    <i class="bi bi-person-check me-1"></i>
                                                    Phân công và chuyển sang đang giao
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

</div>
