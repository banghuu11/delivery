@model List<DeliveryManagement.Models.DeliveryOrder>

@using System.Collections.Generic
@using System.Linq
@using DeliveryManagement.Models

@{
    ViewData["Title"] = "Điều phối đơn giao nhanh";

    var orders = Model ?? new List<DeliveryOrder>();

    var deliveryStaffs =
        ViewBag.DeliveryStaffs as IList<ApplicationUser>
        ?? new List<ApplicationUser>();

    var expressMethods = new[]
    {
        "Nhanh",
        "Giao hỏa tốc",
        "Giao siêu tốc 2h"
    };
}

<div class="container mt-4 mb-5">

    <!-- TIÊU ĐỀ -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="mb-1">
                Điều phối đơn giao nhanh
            </h2>

            <p class="text-muted mb-0">
                Phân công nhân viên giao hàng cho các đơn giao nhanh
                đã được tiếp nhận và chưa có người phụ trách.
            </p>
        </div>

        <a asp-controller="Warehouse"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Quay lại quản lý kho

        </a>

    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-1"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-circle me-1"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng">
            </button>

        </div>
    }

    <!-- THỐNG KÊ -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <div class="text-muted small">
                                Đơn giao nhanh chờ phân công
                            </div>

                            <div class="fs-3 fw-bold">
                                @orders.Count
                            </div>
                        </div>

                        <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                            <i class="bi bi-clock-history text-warning fs-3"></i>
                        </div>

                    </div>

                </div>
            </div>

        </div>

        <div class="col-12 col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <div class="text-muted small">
                                Nhân viên giao hàng
                            </div>

                            <div class="fs-3 fw-bold">
                                @deliveryStaffs.Count
                            </div>
                        </div>

                        <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                            <i class="bi bi-people text-primary fs-3"></i>
                        </div>

                    </div>

                </div>
            </div>

        </div>

        <div class="col-12 col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <div class="text-muted small">
                                Hình thức giao
                            </div>

                            <div class="fs-5 fw-bold text-danger">
                                <i class="bi bi-lightning-fill me-1"></i>
                                Giao nhanh
                            </div>
                        </div>

                        <div class="rounded-circle bg-danger bg-opacity-10 p-3">
                            <i class="bi bi-truck text-danger fs-3"></i>
                        </div>

                    </div>

                </div>
            </div>

        </div>

    </div>

    <!-- MÔ TẢ QUY TRÌNH -->
    <div class="alert alert-info">

        <div class="fw-semibold mb-1">
            <i class="bi bi-info-circle me-1"></i>
            Quy trình phân công
        </div>

        <ol class="mb-0">
            <li>Nhân viên tiếp nhận ghi nhận đơn hàng.</li>
            <li>Đơn giao nhanh xuất hiện trong danh sách chờ phân công.</li>
            <li>Nhân viên kho lựa chọn shipper phụ trách đơn hàng.</li>
            <li>Nhấn Phân công để chuyển đơn sang trạng thái đang giao.</li>
        </ol>

    </div>

    <!-- KIỂM TRA NHÂN VIÊN GIAO HÀNG -->
    @if (orders.Any() && deliveryStaffs.Count == 0)
    {
        <div class="alert alert-warning">

            <i class="bi bi-exclamation-triangle me-1"></i>

            Hiện chưa có tài khoản nào mang vai trò
            <strong>DeliveryStaff</strong>.

            Hãy tạo hoặc cấp đúng vai trò cho tài khoản nhân viên giao hàng
            trước khi thực hiện phân công.

        </div>
    }

    <!-- DANH SÁCH ĐƠN -->
    @if (!orders.Any())
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <i class="bi bi-inbox fs-1 text-muted"></i>

                <h5 class="mt-3">
                    Không có đơn giao nhanh chờ phân công
                </h5>

                <p class="text-muted mb-0">
                    Những đơn giao nhanh đã được tiếp nhận,
                    đang ở trạng thái Đã nhận - Chưa giao
                    và chưa có shipper sẽ xuất hiện tại đây.
                </p>

                <a asp-controller="Warehouse"
                   asp-action="Index"
                   class="btn btn-outline-primary mt-3">

                    <i class="bi bi-list-ul me-1"></i>
                    Xem danh sách đơn hàng

                </a>

            </div>

        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white py-3">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                    <h5 class="mb-0">
                        <i class="bi bi-list-ul me-2"></i>
                        Danh sách đơn giao nhanh chờ phân công
                    </h5>

                    <span class="badge bg-danger">
                        @orders.Count đơn hàng
                    </span>

                </div>

            </div>

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Mã đơn</th>
                                <th>Người nhận</th>
                                <th>Địa chỉ nhận</th>
                                <th>Hình thức</th>
                                <th>Khoảng cách</th>
                                <th>Cước phí</th>
                                <th>Ngày tiếp nhận</th>
                                <th style="min-width: 280px">
                                    Phân công shipper
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var order in orders)
                            {
                                var deliveryMethod =
                                order.DeliveryMethod?.Trim() ?? "";

                                var isExpress =
                                expressMethods.Contains(deliveryMethod);

                                <tr>

                                    <!-- MÃ ĐƠN -->
                                    <td>

                                        <strong>
                                            @order.OrderCode
                                        </strong>

                                        <div class="small mt-1">
                                            <span class="badge bg-warning text-dark">
                                                Chờ phân công
                                            </span>
                                        </div>

                                    </td>

                                    <!-- NGƯỜI NHẬN -->
                                    <td>

                                        <div class="fw-semibold">
                                            @order.ReceiverName
                                        </div>

                                        <div class="small text-muted">
                                            @order.ReceiverPhone
                                        </div>

                                    </td>

                                    <!-- ĐỊA CHỈ -->
                                    <td>
                                        @order.ReceiverAddress
                                    </td>

                                    <!-- HÌNH THỨC GIAO -->
                                    <td>

                                        @if (isExpress)
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-lightning-fill me-1"></i>
                                                @deliveryMethod
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @deliveryMethod
                                            </span>
                                        }

                                    </td>

                                    <!-- KHOẢNG CÁCH -->
                                    <td>
                                        @order.DistanceKm.ToString("0.##") km
                                    </td>

                                    <!-- CƯỚC PHÍ -->
                                    <td>
                                        @order.TotalAmount.ToString("N0") đ
                                    </td>

                                    <!-- NGÀY TIẾP NHẬN -->
                                    <td>
                                        @if (order.ReceivedAt.HasValue)
                                        {
                                            @order.ReceivedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Chưa tiếp nhận
                                            </span>
                                        }
                                    </td>

                                    <!-- PHÂN CÔNG SHIPPER -->
                                    <td>

                                        @if (!isExpress)
                                        {
                                            <span class="text-danger small">
                                                Hình thức giao không hợp lệ để phân công tại đây.
                                            </span>
                                        }
                                        else if (deliveryStaffs.Count == 0)
                                        {
                                            <span class="text-danger small">
                                                Chưa có nhân viên giao hàng.
                                            </span>
                                        }
                                        else
                                        {
                                            <form asp-controller="Warehouse"
                                                  asp-action="AssignExpressOrder"
                                                  method="post"
                                                  class="dispatch-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@order.OrderCode" />

                                                <label class="form-label small fw-semibold">
                                                    Chọn nhân viên giao hàng
                                                </label>

                                                <select name="deliveryStaffId"
                                                        class="form-select form-select-sm mb-2"
                                                        required>

                                                    <option value="">
                                                        -- Chọn shipper --
                                                    </option>

                                                    @foreach (var staff in deliveryStaffs)
                                                    {
                                                        <option value="@staff.Id">
                                                            @staff.FullName (@staff.Email)
                                                        </option>
                                                    }

                                                </select>

                                                <button type="submit"
                                                        class="btn btn-primary btn-sm w-100"
                                                        onclick="return confirm('Bạn có chắc chắn muốn phân công đơn @order.OrderCode cho nhân viên được chọn? Đơn hàng sẽ chuyển sang trạng thái đang giao.');">

                                                    <i class="bi bi-person-check me-1"></i>
                                                    Phân công shipper

                                                </button>

                                            </form>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>

