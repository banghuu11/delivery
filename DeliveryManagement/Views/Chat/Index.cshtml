@{
    ViewData["Title"] = "Trợ lý AI Hỗ trợ khách hàng 24/7";
    int conversationId = ViewBag.ConversationId ?? 0;
    string userFullName = ViewBag.UserFullName ?? "Khách hàng";
}

<div class="container py-4">

    <!-- BREADCRUMB & HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Trợ lý AI Hỗ trợ</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0">
                <span class="text-primary"><i class="bi bi-robot me-2"></i>Trợ Lý AI Tốc Độ</span>
                <span class="badge bg-success bg-opacity-10 text-success fs-6 fw-normal ms-2">
                    <i class="bi bi-circle-fill me-1" style="font-size: 0.6rem;"></i>Trực tuyến 24/7
                </span>
            </h2>
            <p class="text-muted small mb-0">Hỏi đáp thông tin giao hàng, tra cứu tình trạng đơn hàng và tính cước phí dự kiến tự động (Story 11.0)</p>
        </div>
        <div class="d-flex gap-2">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="DeliveryOrder" asp-action="Index" class="btn btn-outline-primary rounded-pill px-3">
                    <i class="bi bi-box-seam me-1"></i> Đơn hàng của tôi
                </a>
            }
            <a asp-controller="DeliveryOrder" asp-action="Create" class="btn btn-tocdo-orange rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Tạo đơn ngay
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- CỘT TRÁI: CÔNG CỤ TÍNH CƯỚC NHANH & DANH MỤC TRỢ GIÚP -->
        <div class="col-lg-4">

            <!-- CÔNG CỤ TÍNH CƯỚC NHANH -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                <div class="card-header bg-primary text-white py-3">
                    <div class="fw-bold d-flex align-items-center">
                        <i class="bi bi-calculator-fill me-2 fs-5"></i>
                        <span>Tính Cước Phí Nhanh</span>
                    </div>
                    <small class="opacity-75">Ước tính theo bảng giá bậc thang thực tế</small>
                </div>
                <div class="card-body p-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted mb-1">Dịch vụ giao</label>
                        <select id="quickService" class="form-select form-select-sm">
                            <option value="Thường">Giao Tiêu Chuẩn (Thường)</option>
                            <option value="Nhanh">Giao Hỏa Tốc (Nhanh 1-3H)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <label class="form-label small fw-semibold text-muted mb-1">Khối lượng (kg)</label>
                            <span id="quickWeightVal" class="small fw-bold text-primary">2.0 kg</span>
                        </div>
                        <input type="range" class="form-range" id="quickWeightRange" min="0.5" max="30" step="0.5" value="2.0" />
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <label class="form-label small fw-semibold text-muted mb-1">Khoảng cách (km)</label>
                            <span id="quickDistVal" class="small fw-bold text-primary">5.0 km</span>
                        </div>
                        <input type="range" class="form-range" id="quickDistRange" min="1" max="50" step="1" value="5" />
                    </div>

                    <button type="button" id="btnQuickCalc" class="btn btn-primary-custom w-100 rounded-pill py-2 fw-semibold">
                        <i class="bi bi-lightning-charge me-1"></i> Tính cước & gửi vào chat
                    </button>

                    <!-- KẾT QUẢ TÍNH NHANH -->
                    <div id="quickCalcResult" class="mt-3 p-3 bg-light rounded-3 d-none">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small">Cước cự ly:</span>
                            <span id="resBaseFee" class="fw-semibold text-dark small">0 đ</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small">Phụ phí cân nặng:</span>
                            <span id="resWeightFee" class="fw-semibold text-dark small">0 đ</span>
                        </div>
                        <div id="rowWeatherSurcharge" class="d-flex justify-content-between align-items-center mb-1 d-none">
                            <span class="text-muted small">Phụ phí thời tiết:</span>
                            <span id="resWeatherFee" class="fw-semibold text-warning small">0 đ</span>
                        </div>
                        <div id="rowTrafficSurcharge" class="d-flex justify-content-between align-items-center mb-1 d-none">
                            <span class="text-muted small">Phụ phí giờ cao điểm:</span>
                            <span id="resTrafficFee" class="fw-semibold text-warning small">0 đ</span>
                        </div>
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark">Tổng cước dự kiến:</span>
                            <span id="resTotalFee" class="fs-5 fw-bold text-primary">0 đ</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CHỦ ĐỀ GỢI Ý THƯỜNG GẶP -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <span class="fw-bold text-dark"><i class="bi bi-lightbulb-fill text-warning me-2"></i>Chủ đề gợi ý</span>
                </div>
                <div class="list-group list-group-flush small">
                    <button type="button" class="list-group-item list-group-item-action py-2 prompt-btn" data-prompt="Đơn hàng của tôi">
                        <i class="bi bi-box-seam text-primary me-2"></i> Tra cứu danh sách đơn của tôi
                    </button>
                    <button type="button" class="list-group-item list-group-item-action py-2 prompt-btn" data-prompt="Tính cước phí dự kiến cho kiện hàng 3kg 10km">
                        <i class="bi bi-currency-dollar text-success me-2"></i> Báo giá gửi hàng 3kg đi 10km
                    </button>
                    <button type="button" class="list-group-item list-group-item-action py-2 prompt-btn" data-prompt="Các loại hàng hóa nhận gửi và quy chuẩn đóng gói">
                        <i class="bi bi-tags text-warning me-2"></i> Danh mục loại hàng & đóng gói
                    </button>
                    <button type="button" class="list-group-item list-group-item-action py-2 prompt-btn" data-prompt="Tìm bưu cục gần nhất">
                        <i class="bi bi-geo-alt text-danger me-2"></i> Danh sách bưu cục tiếp nhận
                    </button>
                    <button type="button" class="list-group-item list-group-item-action py-2 prompt-btn" data-prompt="Thời gian giao hàng bao lâu và chính sách bảo hiểm">
                        <i class="bi bi-shield-check text-info me-2"></i> Thời gian giao & Bảo hiểm 100%
                    </button>
                </div>
            </div>

        </div>

        <!-- CỘT PHẢI: KHUNG CHAT TOÀN DIỆN -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column" style="height: 640px;">

                <!-- HEADER CHAT -->
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div class="position-relative">
                            <div class="rounded-circle bg-primary text-white p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px;">
                                <i class="bi bi-robot fs-4"></i>
                            </div>
                            <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-white rounded-circle"></span>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0">Tốc Độ AI Assistant</h6>
                            <small class="text-muted">Đang hỗ trợ bạn: <span class="fw-semibold text-primary">@userFullName</span></small>
                        </div>
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-light border rounded-pill px-3" type="button" id="btnClearChat">
                            <i class="bi bi-arrow-clockwise me-1"></i> Làm mới hội thoại
                        </button>
                    </div>
                </div>

                <!-- KHUNG CHỨA TIN NHẮN (THREAD) -->
                <div class="card-body p-4 overflow-auto flex-grow-1 bg-light bg-opacity-50" id="mainChatThread">
                    <!-- Loading placeholder ban đầu -->
                    <div id="threadLoading" class="text-center py-5 text-muted">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                        Đang kết nối với Trợ lý AI Tốc Độ...
                    </div>
                </div>

                <!-- KHU VỰC GỢI Ý NHANH (PROMPT CHIPS) -->
                <div class="px-4 py-2 bg-white border-top border-light d-flex gap-2 overflow-auto text-nowrap" id="quickPromptsBar" style="scrollbar-width: thin;">
                    <!-- JS sẽ điền động các chip -->
                </div>

                <!-- FOOTER SOẠN VÀ GỬI TIN NHẮN -->
                <div class="card-footer bg-white p-3 border-top">
                    <form id="chatForm" class="d-flex gap-2 align-items-center">
                        <input type="text" id="chatInput" class="form-control rounded-pill px-4 py-2"
                               placeholder="Hỏi về mã đơn ORD..., tính cước, loại hàng hóa..." autocomplete="off" />
                        <button type="submit" id="btnSend" class="btn btn-primary-custom rounded-pill px-4 py-2 d-flex align-items-center gap-1 shadow-sm">
                            <span>Gửi</span>
                            <i class="bi bi-send-fill ms-1"></i>
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        const currentConvId = @conversationId;
        const mainChatThread = document.getElementById('mainChatThread');
        const chatInput = document.getElementById('chatInput');
        const chatForm = document.getElementById('chatForm');
        const quickPromptsBar = document.getElementById('quickPromptsBar');
        const btnClearChat = document.getElementById('btnClearChat');

        // SLIDERS TÍNH NHANH
        const quickWeightRange = document.getElementById('quickWeightRange');
        const quickWeightVal = document.getElementById('quickWeightVal');
        const quickDistRange = document.getElementById('quickDistRange');
        const quickDistVal = document.getElementById('quickDistVal');
        const quickService = document.getElementById('quickService');
        const btnQuickCalc = document.getElementById('btnQuickCalc');

        quickWeightRange.addEventListener('input', (e) => {
            quickWeightVal.textContent = parseFloat(e.target.value).toFixed(1) + ' kg';
        });

        quickDistRange.addEventListener('input', (e) => {
            quickDistVal.textContent = parseFloat(e.target.value).toFixed(1) + ' km';
        });

        btnQuickCalc.addEventListener('click', async () => {
            const weight = parseFloat(quickWeightRange.value);
            const dist = parseFloat(quickDistRange.value);
            const method = quickService.value;

            // Gọi API tính cước nhanh
            try {
                const res = await fetch('/Chat/EstimateFee', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ deliveryMethod: method, weight: weight, distance: dist })
                });
                const data = await res.json();
                if (data.success && data.data) {
                    const c = data.data;
                    document.getElementById('resBaseFee').textContent = c.baseShippingFee.toLocaleString('vi-VN') + ' đ';
                    document.getElementById('resWeightFee').textContent = c.weightFee.toLocaleString('vi-VN') + ' đ';
                    document.getElementById('resTotalFee').textContent = c.totalPrice.toLocaleString('vi-VN') + ' VNĐ';

                    if (c.weatherFee > 0) {
                        document.getElementById('rowWeatherSurcharge').classList.remove('d-none');
                        document.getElementById('resWeatherFee').textContent = '+' + c.weatherFee.toLocaleString('vi-VN') + ' đ';
                    } else {
                        document.getElementById('rowWeatherSurcharge').classList.add('d-none');
                    }

                    if (c.trafficFee > 0) {
                        document.getElementById('rowTrafficSurcharge').classList.remove('d-none');
                        document.getElementById('resTrafficFee').textContent = '+' + c.trafficFee.toLocaleString('vi-VN') + ' đ';
                    } else {
                        document.getElementById('rowTrafficSurcharge').classList.add('d-none');
                    }

                    document.getElementById('quickCalcResult').classList.remove('d-none');

                    // Đồng thời gửi câu hỏi vào chat để AI tư vấn thêm
                    sendChatMessage(`Tính cước phí kiện hàng ${weight}kg, cự ly ${dist}km gói ${method}`);
                }
            } catch (err) {
                console.error(err);
            }
        });

        // Click các prompt button ở sidebar
        document.querySelectorAll('.prompt-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const p = btn.getAttribute('data-prompt');
                if (p) {
                    sendChatMessage(p);
                }
            });
        });

        // Tải lịch sử tin nhắn ban đầu
        async function loadHistory() {
            try {
                const res = await fetch(`/Chat/History?conversationId=${currentConvId}`);
                const data = await res.json();
                document.getElementById('threadLoading')?.remove();

                if (data.success && data.messages && data.messages.length > 0) {
                    mainChatThread.innerHTML = '';
                    data.messages.forEach(m => appendMessage(m.content, m.isFromAi ? 'ai' : 'user', m.formattedTime));
                } else {
                    mainChatThread.innerHTML = '';
                    // Tin nhắn chào mừng ban đầu
                    appendMessage(`Xin chào **${data.userFullName || 'bạn'}**! 👋 Em là **Trợ lý AI Tốc Độ**.\nEm có thể giúp bạn kiểm tra đơn hàng, tính cước phí dự kiến hoặc giải đáp danh mục hàng hóa. Bạn cần em hỗ trợ gì ngay bây giờ ạ?`, 'ai', 'Vừa xong');
                    renderQuickPrompts([
                        "📦 Đơn hàng của tôi",
                        "💰 Tính cước phí dự kiến",
                        "🏷️ Các loại hàng hóa nhận gửi",
                        "📍 Tìm bưu cục gần nhất"
                    ]);
                }
                scrollToBottom();
            } catch (err) {
                console.error(err);
                mainChatThread.innerHTML = '<div class="alert alert-danger m-3">Lỗi kết nối máy chủ chat.</div>';
            }
        }

        function appendMessage(text, type, timeStr) {
            const isAi = type === 'ai';
            const row = document.createElement('div');
            row.className = `d-flex mb-3 ${isAi ? 'justify-content-start' : 'justify-content-end'}`;

            // Định dạng markdown cơ bản
            let formatted = text
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                .replace(/\n/g, '<br/>');

            row.innerHTML = `
                <div class="d-flex align-items-end gap-2" style="max-width: 85%;">
                    ${isAi ? '<div class="rounded-circle bg-primary text-white p-2 d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width: 34px; height: 34px;"><i class="bi bi-robot"></i></div>' : ''}
                    <div class="card border-0 shadow-sm ${isAi ? 'bg-white' : 'bg-primary text-white'}" style="border-radius: 1rem ${isAi ? '1rem 1rem 0.2rem' : '1rem 0.2rem 1rem'};">
                        <div class="card-body p-3">
                            <div class="small ${isAi ? 'text-dark' : 'text-white'}" style="line-height: 1.5;">${formatted}</div>
                            <div class="text-end mt-1" style="font-size: 0.65rem; opacity: 0.7;">${timeStr || 'Vừa xong'}</div>
                        </div>
                    </div>
                </div>
            `;
            mainChatThread.appendChild(row);
            scrollToBottom();
        }

        function renderQuickPrompts(prompts) {
            quickPromptsBar.innerHTML = '';
            if (!prompts || prompts.length === 0) return;

            prompts.forEach(p => {
                const pill = document.createElement('button');
                pill.type = 'button';
                pill.className = 'btn btn-sm btn-outline-primary rounded-pill px-3 py-1 flex-shrink-0 shadow-none';
                pill.textContent = p;
                pill.addEventListener('click', () => sendChatMessage(p));
                quickPromptsBar.appendChild(pill);
            });
        }

        function scrollToBottom() {
            mainChatThread.scrollTop = mainChatThread.scrollHeight;
        }

        async function sendChatMessage(msgText) {
            if (!msgText || !msgText.trim()) return;
            const text = msgText.trim();
            chatInput.value = '';

            // Hiển thị tin nhắn người dùng
            appendMessage(text, 'user', new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }));

            // Typing indicator
            const typingRow = document.createElement('div');
            typingRow.id = 'typingIndicator';
            typingRow.className = 'd-flex mb-3 justify-content-start';
            typingRow.innerHTML = `
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-primary text-white p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 34px; height: 34px;">
                        <i class="bi bi-robot"></i>
                    </div>
                    <div class="bg-white border rounded-pill px-3 py-2 shadow-sm text-muted small">
                        <span class="spinner-grow spinner-grow-sm text-primary me-1" role="status"></span>
                        AI đang suy nghĩ câu trả lời...
                    </div>
                </div>
            `;
            mainChatThread.appendChild(typingRow);
            scrollToBottom();

            try {
                const res = await fetch('/Chat/SendMessage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: text, conversationId: currentConvId })
                });
                const data = await res.json();
                typingRow.remove();

                if (data.success) {
                    appendMessage(data.reply, 'ai', new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }));
                    if (data.actionUrl && data.actionText) {
                        const actionRow = document.createElement('div');
                        actionRow.className = 'd-flex mb-2 justify-content-start ps-5';
                        actionRow.innerHTML = `
                            <a href="${data.actionUrl}" class="btn btn-sm btn-tocdo-orange rounded-pill px-3 shadow-sm fw-bold">
                                <i class="bi bi-arrow-right-circle me-1"></i> ${data.actionText}
                            </a>
                        `;
                        mainChatThread.appendChild(actionRow);
                        scrollToBottom();
                    }
                    if (data.quickPrompts && data.quickPrompts.length > 0) {
                        renderQuickPrompts(data.quickPrompts);
                    }
                } else {
                    appendMessage("Xin lỗi bạn, hiện tại không thể kết nối tới dịch vụ AI. Vui lòng thử lại sau.", 'ai');
                }
            } catch (err) {
                console.error(err);
                typingRow.remove();
                appendMessage("Đã xảy ra lỗi khi gửi tin nhắn. Vui lòng thử lại.", 'ai');
            }
        }

        chatForm.addEventListener('submit', (e) => {
            e.preventDefault();
            sendChatMessage(chatInput.value);
        });

        btnClearChat.addEventListener('click', () => {
            if (confirm('Làm mới lại khung chat?')) {
                mainChatThread.innerHTML = '';
                loadHistory();
            }
        });

        // Khởi động
        loadHistory();
    </script>
}
