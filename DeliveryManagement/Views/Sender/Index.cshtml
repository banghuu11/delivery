@model DeliveryManagement.Models.ViewModels.SenderProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    var isCustomer = User.IsInRole("Customer");
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- PAGE HEADER: HỒ SƠ CÁ NHÂN -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-gradient-primary-soft text-dark overflow-hidden position-relative">
        <div class="card-body p-4 p-lg-4">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="avatar-circle bg-orange text-white shadow-sm"
                             style="width: 68px; height: 68px; font-size: 1.7rem; flex-shrink: 0;">
                            @(string.IsNullOrWhiteSpace(Model.FullName)
                                                        ? "U"
                                                        : Model.FullName.Trim().Substring(0, 1).ToUpper())
                        </div>

                        <div>
                            <span class="badge bg-white text-primary border rounded-pill px-3 py-2 mb-2">
                                <i class="bi bi-person-vcard-fill me-1"></i>
                                @(isCustomer ? "HỒ SƠ KHÁCH HÀNG" : "HỒ SƠ CÁ NHÂN")
                            </span>

                            <h2 class="fw-bold mb-1 text-dark">
                                @(string.IsNullOrWhiteSpace(Model.FullName)
                                                                ? "Xin chào!"
                                                                : Model.FullName)
                            </h2>

                            <div class="text-secondary">
                                <i class="bi bi-envelope me-1"></i>@Model.Email
                            </div>
                        </div>
                    </div>

                    @if (isCustomer)
                    {
                        <p class="text-secondary mb-0">
                            Quản lý thông tin liên hệ, địa chỉ lấy hàng và bảo mật tài khoản
                            để việc tạo và gửi đơn hàng thuận tiện hơn.
                        </p>
                    }
                    else
                    {
                        <p class="text-secondary mb-0">
                            Quản lý thông tin cá nhân và bảo mật tài khoản của chính bạn.
                        </p>
                    }
                </div>

                @if (isCustomer)
                {
                    <div class="col-lg-4 text-lg-end">
                        <a asp-controller="DeliveryOrder"
                           asp-action="Create"
                           class="btn btn-primary-custom px-4 py-3 rounded-pill shadow-sm fw-bold">
                            <i class="bi bi-send-plus-fill me-2"></i>Gửi đơn hàng mới
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- CỘT TRÁI: THÔNG TIN CÁ NHÂN VÀ BẢO MẬT -->
        <div class="@(isCustomer ? "col-lg-5" : "col-lg-8 col-xl-7 mx-auto")">
            <!-- THÔNG TIN CÁ NHÂN -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar-circle fs-4 bg-orange text-white" style="width: 50px; height: 50px;">
                            @(string.IsNullOrWhiteSpace(Model.FullName)
                                                        ? "U"
                                                        : Model.FullName.Trim().Substring(0, 1).ToUpper())
                        </div>

                        <div>
                            <h5 class="fw-bold mb-0 text-dark">
                                @(isCustomer ? "Thông tin người gửi mặc định" : "Thông tin cá nhân")
                            </h5>

                            <small class="text-muted">
                                @(isCustomer
                                                                ? "Thông tin dùng làm mặc định khi tạo đơn gửi hàng"
                                                                : "Thông tin của tài khoản đang đăng nhập")
                            </small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="UpdateProfile" method="post">
                        <input type="hidden" asp-for="UserId" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">
                                Email đăng nhập
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-envelope text-muted"></i>
                                </span>

                                <input value="@Model.Email"
                                       class="form-control bg-light border-start-0"
                                       readonly />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold text-secondary small">
                                Họ và tên <span class="text-danger">*</span>
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-person text-muted"></i>
                                </span>

                                <input asp-for="FullName"
                                       class="form-control border-start-0"
                                       placeholder="Nhập họ và tên"
                                       required />
                            </div>

                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold text-secondary small">
                                Số điện thoại liên hệ <span class="text-danger">*</span>
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-telephone text-muted"></i>
                                </span>

                                <input asp-for="PhoneNumber"
                                       class="form-control border-start-0"
                                       placeholder="Nhập số điện thoại"
                                       required />
                            </div>

                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        @if (isCustomer)
                        {
                            <div class="mb-4">
                                <label asp-for="DefaultSenderAddress" class="form-label fw-semibold text-secondary small">
                                    Địa chỉ lấy hàng mặc định
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-geo-alt text-muted"></i>
                                    </span>

                                    <textarea asp-for="DefaultSenderAddress"
                                              class="form-control border-start-0"
                                              rows="3"
                                              placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố..."></textarea>
                                </div>

                                <small class="text-muted">
                                    Địa chỉ này có thể được điền sẵn khi bạn tạo đơn mới.
                                </small>
                            </div>
                        }

                        <button type="submit" class="btn btn-primary-custom w-100 py-2 rounded-3 fw-bold">
                            <i class="bi bi-check2-circle me-1"></i>Lưu thay đổi
                        </button>
                    </form>
                </div>
            </div>

            <!-- BẢO MẬT VÀ ĐỔI MẬT KHẨU: MỌI ROLE ĐÃ ĐĂNG NHẬP -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-shield-lock-fill text-primary me-2"></i>Bảo mật tài khoản
                    </h5>
                    <small class="text-muted">Thay đổi mật khẩu đăng nhập của bạn</small>
                </div>

                <div class="card-body p-4">
                    <form asp-action="ChangePassword" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">
                                Mật khẩu hiện tại
                            </label>

                            <input name="CurrentPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   required
                                   placeholder="Nhập mật khẩu hiện tại" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">
                                Mật khẩu mới
                            </label>

                            <input name="NewPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   required
                                   placeholder="Tối thiểu 6 ký tự" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">
                                Xác nhận mật khẩu mới
                            </label>

                            <input name="ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   required
                                   placeholder="Nhập lại mật khẩu mới" />
                        </div>

                        <button type="submit" class="btn btn-outline-secondary w-100 py-2 rounded-3 fw-semibold">
                            <i class="bi bi-key-fill me-1"></i>Cập nhật mật khẩu
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @if (isCustomer)
        {
            <!-- CỘT PHẢI: SỔ ĐỊA CHỈ CHỈ DÀNH CHO CUSTOMER -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-3">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h5 class="fw-bold mb-1 text-dark">
                                    <i class="bi bi-journal-bookmark-fill text-orange me-2"></i>Sổ địa chỉ người gửi
                                </h5>

                                <small class="text-muted">
                                    Lưu các điểm lấy hàng (kho hàng, chi nhánh, nhà riêng...) để chọn nhanh khi tạo đơn.
                                </small>
                            </div>

                            <button type="button"
                                    class="btn btn-primary-custom rounded-pill px-3 py-2 fw-semibold btn-sm shadow-xs"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalAddAddress">
                                <i class="bi bi-plus-lg me-1"></i>Thêm địa chỉ mới
                            </button>
                        </div>
                    </div>

                    <div class="card-body px-4 pb-4 pt-1">
                        @if (Model.SavedAddresses == null || !Model.SavedAddresses.Any())
                        {
                            <div class="text-center py-5">
                                <div class="mb-3">
                                    <i class="bi bi-geo-alt text-muted" style="font-size: 3.5rem;"></i>
                                </div>

                                <h6 class="fw-bold text-dark mb-1">
                                    Chưa có địa chỉ nào trong sổ địa chỉ
                                </h6>

                                <p class="text-muted small mb-3">
                                    Thêm địa chỉ kho hàng hoặc điểm lấy hàng để thuận tiện khi gửi hàng.
                                </p>

                                <button type="button"
                                        class="btn btn-outline-primary rounded-pill px-4"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalAddAddress">
                                    <i class="bi bi-plus-circle me-1"></i>Thêm địa chỉ đầu tiên
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var addr in Model.SavedAddresses)
                                {
                                    <div class="card border @(addr.IsDefault ? "border-primary bg-primary-subtle bg-opacity-10 shadow-xs" : "border-light-subtle bg-white") rounded-3 p-3 transition-card">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                                    <span class="badge bg-light text-dark border px-2 py-1 fw-bold">
                                                        <i class="bi bi-tag-fill text-orange me-1"></i>@(string.IsNullOrWhiteSpace(addr.AddressTag) ? "Điểm gửi hàng" : addr.AddressTag)
                                                    </span>

                                                    @if (addr.IsDefault)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                                            <i class="bi bi-check-circle-fill me-1"></i>Mặc định
                                                        </span>
                                                    }
                                                </div>

                                                <h6 class="fw-bold text-dark mb-1">@addr.SenderName</h6>

                                                <div class="text-muted small mb-2">
                                                    <i class="bi bi-telephone-fill me-1 text-secondary"></i>@addr.SenderPhone
                                                </div>

                                                <div class="text-secondary small">
                                                    <i class="bi bi-geo-alt-fill me-1 text-danger"></i>@addr.SenderAddressText
                                                </div>
                                            </div>

                                            <div class="d-flex flex-column align-items-end gap-1">
                                                @if (!addr.IsDefault)
                                                {
                                                    <form asp-action="SetDefaultAddress"
                                                          asp-route-id="@addr.Id"
                                                          method="post"
                                                          class="d-inline">
                                                        <button type="submit"
                                                                class="btn btn-sm btn-link text-primary text-decoration-none p-0 small"
                                                                title="Đặt làm địa chỉ mặc định">
                                                            <i class="bi bi-star me-1"></i>Đặt mặc định
                                                        </button>
                                                    </form>
                                                }

                                                <div class="btn-group btn-group-sm mt-2">
                                                    <button type="button"
                                                            class="btn btn-outline-secondary btn-sm"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#modalEditAddress"
                                                            data-id="@addr.Id"
                                                            data-name="@addr.SenderName"
                                                            data-phone="@addr.SenderPhone"
                                                            data-address="@addr.SenderAddressText"
                                                            data-tag="@addr.AddressTag"
                                                            data-default="@addr.IsDefault.ToString().ToLower()"
                                                            title="Sửa địa chỉ">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>

                                                    <form asp-action="DeleteAddress"
                                                          asp-route-id="@addr.Id"
                                                          method="post"
                                                          class="d-inline"
                                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa địa chỉ này khỏi sổ địa chỉ?');">
                                                        <button type="submit"
                                                                class="btn btn-outline-danger btn-sm"
                                                                title="Xóa địa chỉ">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (isCustomer)
{
    <!-- MODAL THÊM ĐỊA CHỈ MỚI: CHỈ CUSTOMER -->
    <div class="modal fade"
         id="modalAddAddress"
         tabindex="-1"
         aria-labelledby="modalAddAddressLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark" id="modalAddAddressLabel">
                        <i class="bi bi-plus-circle text-primary me-2"></i>Thêm địa chỉ người gửi mới
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Đóng"></button>
                </div>

                <form asp-action="AddAddress" method="post">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">
                                Tên nhãn địa chỉ (VD: Kho hàng Q.1, nhà riêng, chi nhánh...)
                            </label>
                            <input name="AddressTag"
                                   class="form-control"
                                   placeholder="Kho hàng chính" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">
                                Họ và tên người gửi tại điểm này <span class="text-danger">*</span>
                            </label>
                            <input name="SenderName"
                                   class="form-control"
                                   value="@Model.FullName"
                                   placeholder="Họ tên người gửi"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">
                                Số điện thoại liên hệ <span class="text-danger">*</span>
                            </label>
                            <input name="SenderPhone"
                                   class="form-control"
                                   value="@Model.PhoneNumber"
                                   placeholder="Số điện thoại"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">
                                Địa chỉ lấy hàng chi tiết <span class="text-danger">*</span>
                            </label>
                            <textarea name="SenderAddressText"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh..."
                                  required></textarea>
                        </div>

                        <div class="form-check">
                            <input name="IsDefault"
                                   class="form-check-input"
                                   type="checkbox"
                                   value="true"
                                   id="addIsDefault" />

                            <label class="form-check-label fw-semibold small" for="addIsDefault">
                                Đặt làm địa chỉ lấy hàng mặc định
                            </label>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button"
                                class="btn btn-light rounded-pill px-4"
                                data-bs-dismiss="modal">
                            Hủy
                        </button>

                        <button type="submit"
                                class="btn btn-primary-custom rounded-pill px-4 fw-bold">
                            Lưu địa chỉ
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL SỬA ĐỊA CHỈ: CHỈ CUSTOMER -->
    <div class="modal fade"
         id="modalEditAddress"
         tabindex="-1"
         aria-labelledby="modalEditAddressLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark" id="modalEditAddressLabel">
                        <i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh sửa địa chỉ người gửi
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Đóng"></button>
                </div>

                <form asp-action="EditAddress" method="post">
                    <input type="hidden" name="Id" id="editAddressId" />

                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">
                                Tên nhãn địa chỉ
                            </label>
                            <input name="AddressTag"
                                   id="editAddressTag"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">
                                Họ và tên người gửi <span class="text-danger">*</span>
                            </label>
                            <input name="SenderName"
                                   id="editSenderName"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">
                                Số điện thoại liên hệ <span class="text-danger">*</span>
                            </label>
                            <input name="SenderPhone"
                                   id="editSenderPhone"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">
                                Địa chỉ lấy hàng chi tiết <span class="text-danger">*</span>
                            </label>
                            <textarea name="SenderAddressText"
                                  id="editSenderAddressText"
                                  class="form-control"
                                  rows="3"
                                  required></textarea>
                        </div>

                        <div class="form-check">
                            <input name="IsDefault"
                                   class="form-check-input"
                                   type="checkbox"
                                   value="true"
                                   id="editIsDefault" />

                            <label class="form-check-label fw-semibold small" for="editIsDefault">
                                Đặt làm địa chỉ lấy hàng mặc định
                            </label>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button"
                                class="btn btn-light rounded-pill px-4"
                                data-bs-dismiss="modal">
                            Hủy
                        </button>

                        <button type="submit"
                                class="btn btn-primary-custom rounded-pill px-4 fw-bold">
                            Cập nhật
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (isCustomer)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var modalEdit = document.getElementById('modalEditAddress');

                if (modalEdit) {
                    modalEdit.addEventListener('show.bs.modal', function (event) {
                        var button = event.relatedTarget;
                        if (!button) return;

                        document.getElementById('editAddressId').value =
                            button.getAttribute('data-id') || '';

                        document.getElementById('editSenderName').value =
                            button.getAttribute('data-name') || '';

                        document.getElementById('editSenderPhone').value =
                            button.getAttribute('data-phone') || '';

                        document.getElementById('editSenderAddressText').value =
                            button.getAttribute('data-address') || '';

                        document.getElementById('editAddressTag').value =
                            button.getAttribute('data-tag') || '';

                        document.getElementById('editIsDefault').checked =
                            button.getAttribute('data-default') === 'true';
                    });
                }
            });
        </script>
    }
}