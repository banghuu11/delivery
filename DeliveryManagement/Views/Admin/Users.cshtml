@model List<DeliveryManagement.Models.ViewModels.UserListViewModel>
@{
    ViewData["Title"] = "Quản lý tài khoản & Phân quyền";
    string search = ViewBag.Search as string ?? "";
    string selectedRole = ViewBag.SelectedRole as string ?? "";
    var allRoles = ViewBag.AllRoles as List<string> ?? new List<string>();
}

<div class="container-fluid py-4 px-lg-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Quản Lý Tài Khoản & Phân Quyền</h2>
            <p class="text-muted mb-0">Quản trị danh sách thành viên, cấp quyền nhân viên và bảo mật hệ thống.</p>
        </div>
        <div>
            <a asp-action="CreateUser" class="btn btn-primary-custom shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Thêm tài khoản mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- BỘ LỌC VÀ TÌM KIẾM -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="Tìm theo tên, email, số điện thoại..." value="@search" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="role" class="form-select">
                        <option value="">-- Tất cả vai trò --</option>
                        @foreach (var r in allRoles)
                        {
                            <option value="@r" selected="@(selectedRole == r)">@r</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary-custom flex-grow-1">Lọc</button>
                    <a asp-action="Users" class="btn btn-outline-secondary">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    <!-- BẢNG TÀI KHOẢN -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Họ và tên</th>
                            <th>Email (Tên đăng nhập)</th>
                            <th>Số điện thoại</th>
                            <th>Vai trò (Role)</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Không tìm thấy tài khoản nào phù hợp.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <div class="d-flex align-items-center">
                                            <span class="avatar-circle me-2">@(string.IsNullOrWhiteSpace(user.FullName) ? "U" : user.FullName.Substring(0, 1))</span>
                                            <div>@user.FullName</div>
                                        </div>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>@(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "-" : user.PhoneNumber)</td>
                                    <td>
                                        @{
                                            string roleBadge = user.Role switch
                                            {
                                                "Admin" => "bg-danger",
                                                "ReceptionStaff" => "bg-info text-dark",
                                                "WarehouseStaff" => "bg-primary",
                                                "DeliveryStaff" => "bg-warning text-dark",
                                                "Customer" => "bg-success",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @roleBadge px-2 py-1">@user.Role</span>
                                    </td>
                                    <td>
                                        @if (user.IsLockedOut)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger">Bị khóa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success">Hoạt động</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary me-1" title="Sửa thông tin / Đổi quyền">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        @if (user.Email != "admin@delivery.com")
                                        {
                                            <form asp-action="ToggleLock" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn thay đổi trạng thái khóa/mở cho tài khoản này?');">
                                                <button type="submit" class="btn btn-sm @(user.IsLockedOut ? "btn-outline-success" : "btn-outline-danger")" title="@(user.IsLockedOut ? "Mở khóa" : "Khóa tài khoản")">
                                                    <i class="bi @(user.IsLockedOut ? "bi-unlock" : "bi-lock")"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
