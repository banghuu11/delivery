@model DeliveryManagement.Models.ViewModels.PackageTypeIndexViewModel
@{
    ViewData["Title"] = "Quản lý danh mục loại hàng hóa";
}

<div class="container-fluid py-4 px-lg-4">

    <!-- HEADER TITLE & ACTIONS -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                    <i class="bi bi-tags-fill fs-4"></i>
                </div>
                <div>
                    <h2 class="fw-bold mb-0">Quản Lý Danh Mục Loại Hàng Hóa</h2>
                    <p class="text-muted small mb-0">Quy định quy cách đóng gói, loại kiện hàng áp dụng trong tiếp nhận, tính giá và lưu kho (Story 22.0 - Admin)</p>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="PackageTypes" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
            </a>
            <button type="button" class="btn btn-primary-custom shadow-sm" data-bs-toggle="modal" data-bs-target="#createPackageModal">
                <i class="bi bi-plus-circle me-1"></i> Thêm loại hàng mới
            </button>
        </div>
    </div>

    <!-- ALERT MESSAGES -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-octagon-fill fs-5 me-2 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI STATS CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-medium">Tổng danh mục</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalCount</div>
                        <div class="text-muted small">Quy cách hàng hóa</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3">
                        <i class="bi bi-collection-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-medium">Đang áp dụng</div>
                        <div class="fs-3 fw-bold text-success mt-1">@Model.ActiveCount</div>
                        <div class="text-success small"><i class="bi bi-check2-circle me-1"></i>Khách hàng chọn được</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-medium">Ngưng áp dụng</div>
                        <div class="fs-3 fw-bold text-secondary mt-1">@Model.InactiveCount</div>
                        <div class="text-secondary small"><i class="bi bi-slash-circle me-1"></i>Tạm dừng tiếp nhận</div>
                    </div>
                    <div class="rounded-circle bg-secondary bg-opacity-10 text-secondary p-3">
                        <i class="bi bi-pause-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-medium">Tổng kiện hàng liên kết</div>
                        <div class="fs-3 fw-bold text-warning mt-1">@Model.TotalItemsInOrders</div>
                        <div class="text-muted small">Đã ghi nhận trong đơn</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3">
                        <i class="bi bi-boxes fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTER & SEARCH BAR -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="PackageTypes" class="row g-2 align-items-center">
                <div class="col-lg-6 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Tìm theo tên loại hàng hoặc mô tả quy cách..." />
                    </div>
                </div>
                <div class="col-lg-4 col-md-4">
                    <div class="btn-group w-100" role="group">
                        <a asp-action="PackageTypes" asp-route-search="@Model.SearchTerm" asp-route-status="all"
                           class="btn btn-outline-primary @(Model.StatusFilter == "all" ? "active" : "")">
                            Tất cả (@Model.TotalCount)
                        </a>
                        <a asp-action="PackageTypes" asp-route-search="@Model.SearchTerm" asp-route-status="active"
                           class="btn btn-outline-success @(Model.StatusFilter == "active" ? "active" : "")">
                            Đang dùng (@Model.ActiveCount)
                        </a>
                        <a asp-action="PackageTypes" asp-route-search="@Model.SearchTerm" asp-route-status="inactive"
                           class="btn btn-outline-secondary @(Model.StatusFilter == "inactive" ? "active" : "")">
                            Ngưng (@Model.InactiveCount)
                        </a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary-custom w-100">
                        <i class="bi bi-funnel me-1"></i> Lọc
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.StatusFilter != "all")
                    {
                        <a asp-action="PackageTypes" class="btn btn-outline-secondary" title="Hủy lọc">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- TABLE CARD -->
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <div class="fw-bold text-dark">
                <i class="bi bi-list-stars text-primary me-2"></i>Danh sách loại hàng hóa
                <span class="badge bg-light text-dark border ms-2">@Model.Items.Count kết quả</span>
            </div>
            <small class="text-muted">Nhấn vào trạng thái để bật/tắt nhanh</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 80px;"># ID</th>
                            <th style="min-width: 180px;">Tên loại hàng</th>
                            <th style="min-width: 250px;">Mô tả quy cách đóng gói</th>
                            <th class="text-center" style="width: 140px;">Kiện hàng liên kết</th>
                            <th class="text-center" style="width: 160px;">Trạng thái áp dụng</th>
                            <th class="text-end pe-4" style="width: 140px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items == null || !Model.Items.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    Không tìm thấy loại hàng hóa nào phù hợp với bộ lọc.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">
                                        #@item.PackageTypeId
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded p-2">
                                                <i class="bi bi-box-seam"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@item.TypeName</div>
                                                <small class="text-muted">Kiểu kiện hàng</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-secondary">
                                            @(string.IsNullOrWhiteSpace(item.Description) ? "— Không có mô tả chi tiết —" : item.Description)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.AssociatedOrderItemsCount > 0)
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info fw-bold px-2 py-1 rounded-pill">
                                                <i class="bi bi-box me-1"></i>@item.AssociatedOrderItemsCount kiện
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border px-2 py-1 rounded-pill">Chưa có</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="TogglePackageTypeStatus" asp-route-id="@item.PackageTypeId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            @if (item.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 shadow-none" title="Nhấn để ngưng áp dụng">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Đang áp dụng
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 shadow-none" title="Nhấn để kích hoạt áp dụng">
                                                    <i class="bi bi-pause-circle-fill me-1"></i> Ngưng áp dụng
                                                </button>
                                            }
                                        </form>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editModal_@item.PackageTypeId" title="Chỉnh sửa thông tin">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <form asp-action="DeletePackageType" asp-route-id="@item.PackageTypeId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa hoặc ngưng áp dụng loại hàng @item.TypeName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa loại hàng">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>

                                <!-- MODAL SỬA LOẠI HÀNG -->
                                <div class="modal fade" id="editModal_@item.PackageTypeId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow rounded-3">
                                            <form asp-action="EditPackageType" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="PackageTypeId" value="@item.PackageTypeId" />
                                                <div class="modal-header border-bottom bg-light">
                                                    <h5 class="modal-title fw-bold">
                                                        <i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh sửa loại hàng #@item.PackageTypeId
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body p-4">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Tên loại hàng <span class="text-danger">*</span></label>
                                                        <input type="text" name="TypeName" class="form-control" value="@item.TypeName" required />
                                                        <small class="text-muted">Ví dụ: Gói nhỏ, Thùng carton, Laptop, Tivi...</small>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Mô tả quy cách đóng gói</label>
                                                        <textarea name="Description" class="form-control" rows="3" placeholder="Ghi chú về đóng gói, kích thước, giới hạn...">@item.Description</textarea>
                                                    </div>
                                                    <div class="form-check form-switch p-3 bg-light rounded-3">
                                                        <input class="form-check-input ms-0 me-3" type="checkbox" name="IsActive" value="true" @(item.IsActive ? "checked" : "") id="active_@item.PackageTypeId" />
                                                        <label class="form-check-label fw-semibold" for="active_@item.PackageTypeId">
                                                            Đang áp dụng (Khách hàng và nhân viên có thể chọn)
                                                        </label>
                                                    </div>
                                                    @if (item.AssociatedOrderItemsCount > 0)
                                                    {
                                                        <div class="alert alert-info mt-3 py-2 small mb-0">
                                                            <i class="bi bi-info-circle me-1"></i> Đang có <strong>@item.AssociatedOrderItemsCount</strong> kiện hàng sử dụng loại này.
                                                        </div>
                                                    }
                                                </div>
                                                <div class="modal-footer border-top bg-light">
                                                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                                                    <button type="submit" class="btn btn-primary-custom rounded-pill px-4">Lưu thay đổi</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- MODAL TẠO MỚI LOẠI HÀNG -->
<div class="modal fade" id="createPackageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-3">
            <form asp-action="CreatePackageType" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom bg-light">
                    <h5 class="modal-title fw-bold text-primary">
                        <i class="bi bi-plus-circle-fill me-2"></i>Thêm loại hàng hóa mới
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên loại hàng hóa <span class="text-danger">*</span></label>
                        <input type="text" name="TypeName" class="form-control" placeholder="VD: Gốm sứ dễ vỡ, Máy tính để bàn..." required />
                        <small class="text-muted">Tên phân loại ngắn gọn, dễ nhận biết.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả quy cách đóng gói</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Ghi chú chi tiết về cách đóng gói, chèn mút xốp hoặc quy chuẩn vận chuyển..."></textarea>
                    </div>
                    <div class="p-3 bg-light rounded-3 small text-muted">
                        <i class="bi bi-lightbulb-fill text-warning me-1"></i>
                        Loại hàng sau khi tạo sẽ tự động kích hoạt và hiển thị ngay trên form đặt đơn của khách hàng cũng như màn hình phân loại của nhân viên kho.
                    </div>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary-custom rounded-pill px-4">Tạo loại hàng</button>
                </div>
            </form>
        </div>
    </div>
</div>
