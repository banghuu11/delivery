@model List<DeliveryManagement.Models.DeliveryOrder>
@{
    ViewData["Title"] = "Quản lý toàn bộ đơn hàng";
    string search = ViewBag.Search as string ?? "";
    string selectedStatus = ViewBag.SelectedStatus as string ?? "";
    var allStatuses = ViewBag.AllStatuses as List<string> ?? new List<string>();
}

<div class="container-fluid py-4 px-lg-4">

    <!-- ADMIN NAVBAR -->
    @await Html.PartialAsync("_AdminNavBar")

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-card-checklist text-primary me-2"></i>Quản Lý Toàn Bộ Đơn Hàng</h2>
            <p class="text-muted mb-0">Theo dõi, lọc và can thiệp cập nhật trạng thái mọi đơn hàng trong hệ thống.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- BỘ LỌC TÌM KIẾM -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="Tìm theo mã đơn, người gửi, người nhận, SĐT..." value="@search" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="status" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        @foreach (var s in allStatuses)
                        {
                            <option value="@s" selected="@(selectedStatus == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary-custom flex-grow-1">Lọc</button>
                    <a asp-action="Orders" class="btn btn-outline-secondary">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    <!-- BẢNG ĐƠN HÀNG -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng / Người gửi</th>
                            <th>Người nhận</th>
                            <th>Hình thức / Khoảng cách</th>
                            <th>Tổng cước</th>
                            <th>Ngày tạo</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">Không tìm thấy đơn hàng nào phù hợp.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="OrderDetails" asp-route-id="@order.OrderCode" class="fw-bold text-primary text-decoration-none">
                                            @order.OrderCode
                                        </a>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@order.SenderName</div>
                                        <small class="text-muted">@order.SenderPhone</small>
                                    </td>
                                    <td>
                                        <div>@order.ReceiverName</div>
                                        <small class="text-muted">@order.ReceiverPhone</small>
                                    </td>
                                    <td>
                                        <span class="badge @(order.DeliveryMethod == "Nhanh" ? "bg-warning text-dark" : "bg-light text-dark border")">@order.DeliveryMethod</span>
                                        <small class="text-muted d-block">@order.DistanceKm km</small>
                                    </td>
                                    <td class="fw-bold text-success">@order.TotalAmount.ToString("N0") đ</td>
                                    <td class="small text-muted">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @{
                                            string badgeClass = order.CurrentStatus switch
                                            {
                                                "Chưa nhận" => "bg-secondary",
                                                "Đã nhận" or "Đã tiếp nhận" => "bg-info text-dark",
                                                "Trong kho" => "bg-primary",
                                                "Đang giao" => "bg-warning text-dark",
                                                "Đã giao" or "Giao thành công" => "bg-success",
                                                "Đã hủy" or "Giao thất bại" => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass">@order.CurrentStatus</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="OrderDetails" asp-route-id="@order.OrderCode" class="btn btn-sm btn-outline-primary" title="Xem chi tiết & Can thiệp">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
