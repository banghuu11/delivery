@model List<DeliveryManagement.Models.DeliveryOrder>
@{
    ViewData["Title"] = "Quản lý toàn bộ đơn hàng";
    string search = ViewBag.Search as string ?? "";
    string selectedStatus = ViewBag.SelectedStatus as string ?? "";
    var allStatuses = ViewBag.AllStatuses as List<string> ?? new List<string>();
}

<div class="container-fluid py-4 px-lg-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-card-checklist text-primary me-2"></i>Quản Lý Toàn Bộ Đơn Hàng</h2>
            <p class="text-muted mb-0">Theo dõi, tạo mới, chỉnh sửa và quản lý vòng đời mọi đơn hàng trong hệ thống.</p>
        </div>
        <div>
            <a asp-action="CreateOrder" class="btn btn-tocdo-orange rounded-pill px-4 shadow-sm fw-bold">
                <i class="bi bi-plus-lg me-1"></i> Tạo Đơn Hàng Mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- BỘ LỌC TÌM KIẾM -->
    <div class="card shadow-sm border-0 mb-4 rounded-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control border-0 bg-light" placeholder="Tìm theo mã đơn, người gửi, người nhận, SĐT..." value="@search" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="status" class="form-select border-0 bg-light">
                        <option value="">-- Tất cả trạng thái --</option>
                        @foreach (var s in allStatuses)
                        {
                            <option value="@s" selected="@(selectedStatus == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 flex-grow-1">Lọc</button>
                    <a asp-action="Orders" class="btn btn-outline-secondary rounded-pill px-3">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    <!-- BẢNG ĐƠN HÀNG -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng / Người gửi</th>
                            <th>Người nhận</th>
                            <th>Hình thức / Khoảng cách</th>
                            <th>Tổng cước</th>
                            <th>Ngày tạo</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    Không tìm thấy đơn hàng nào phù hợp.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="OrderDetails" asp-route-id="@order.OrderCode" class="fw-bold text-primary text-decoration-none">
                                            #@order.OrderCode
                                        </a>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@order.SenderName</div>
                                        <small class="text-muted"><i class="bi bi-telephone me-1"></i>@order.SenderPhone</small>
                                    </td>
                                    <td>
                                        <div>@order.ReceiverName</div>
                                        <small class="text-muted"><i class="bi bi-telephone me-1"></i>@order.ReceiverPhone</small>
                                    </td>
                                    <td>
                                        <span class="badge @(order.DeliveryMethod.Contains("hỏa tốc", StringComparison.OrdinalIgnoreCase) ? "bg-warning text-dark" : "bg-light text-dark border")">
                                            @order.DeliveryMethod
                                        </span>
                                        <small class="text-muted d-block">@order.DistanceKm km</small>
                                    </td>
                                    <td class="fw-bold text-success">@order.TotalAmount.ToString("N0") đ</td>
                                    <td class="small text-muted">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @{
                                            string badgeClass = order.CurrentStatus switch
                                            {
                                                "Chưa nhận" => "bg-secondary",
                                                "Chờ tiếp nhận" => "bg-warning text-dark",
                                                "Đã nhận" or "Đã tiếp nhận" => "bg-info text-dark",
                                                "Trong kho" => "bg-primary",
                                                "Đang giao" => "bg-orange text-white",
                                                "Đã giao" or "Giao thành công" => "bg-success",
                                                "Đã hủy" or "Giao thất bại" => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass rounded-pill px-3 py-1">@order.CurrentStatus</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="OrderDetails" asp-route-id="@order.OrderCode" class="btn btn-outline-primary" title="Xem chi tiết">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                            <a asp-action="EditOrder" asp-route-id="@order.OrderCode" class="btn btn-outline-secondary" title="Chỉnh sửa đơn hàng">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteOrderModal-@order.OrderCode" title="Xóa đơn hàng">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </div>

                                        <!-- MODAL XÓA ĐƠN HÀNG -->
                                        <div class="modal fade" id="deleteOrderModal-@order.OrderCode" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered text-start">
                                                <div class="modal-content border-0 shadow rounded-4">
                                                    <div class="modal-header border-0 pb-0">
                                                        <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa đơn hàng</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body py-4">
                                                        <p class="mb-2">Bạn có chắc chắn muốn xóa vĩnh viễn đơn hàng <strong class="text-dark">#@order.OrderCode</strong>?</p>
                                                        <div class="bg-light p-3 rounded-3 small text-muted">
                                                            <div><strong>Người gửi:</strong> @order.SenderName (@order.SenderPhone)</div>
                                                            <div><strong>Người nhận:</strong> @order.ReceiverName (@order.ReceiverPhone)</div>
                                                            <div><strong>Tổng tiền:</strong> @order.TotalAmount.ToString("N0") đ</div>
                                                        </div>
                                                        <small class="text-danger mt-2 d-block"><i class="bi bi-info-circle me-1"></i> Hành động này không thể khôi phục!</small>
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                                                        <form asp-action="DeleteOrder" asp-route-id="@order.OrderCode" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                                                                Xóa Vĩnh Viễn
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

