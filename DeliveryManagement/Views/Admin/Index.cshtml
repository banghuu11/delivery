@model DeliveryManagement.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Quản trị hệ thống - Dashboard";
}

<div class="container-fluid py-4 px-lg-4">

    <!-- ADMIN NAVBAR -->
    @await Html.PartialAsync("_AdminNavBar")

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Bảng Điều Khiển Quản Trị (Admin)</h2>
            <p class="text-muted mb-0">Thống kê toàn diện hệ thống vận chuyển, người dùng và tiến độ đơn hàng.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Users" class="btn btn-outline-primary">
                <i class="bi bi-people me-1"></i> Quản lý tài khoản
            </a>
            <a asp-action="Orders" class="btn btn-primary-custom">
                <i class="bi bi-box-seam me-1"></i> Quản lý đơn hàng
            </a>
        </div>
    </div>

    <!-- STATS KPI CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card shadow-sm border-0 border-start border-primary border-4 p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Tổng số đơn hàng</div>
                        <h3 class="fw-bold my-1 text-primary">@Model.TotalOrders</h3>
                        <small class="text-success"><i class="bi bi-arrow-up-short"></i> Toàn hệ thống</small>
                    </div>
                    <div class="stat-icon-bg bg-primary-subtle text-primary">
                        <i class="bi bi-box-seam fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card stat-card shadow-sm border-0 border-start border-success border-4 p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Doanh thu tạm tính</div>
                        <h3 class="fw-bold my-1 text-success">@Model.TotalRevenue.ToString("N0") đ</h3>
                        <small class="text-muted">Đơn không bị hủy</small>
                    </div>
                    <div class="stat-icon-bg bg-success-subtle text-success">
                        <i class="bi bi-currency-dollar fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card stat-card shadow-sm border-0 border-start border-warning border-4 p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Đang xử lý / Giao</div>
                        <h3 class="fw-bold my-1 text-warning">@(Model.InWarehouseOrders + Model.DeliveringOrders)</h3>
                        <small class="text-muted">Kho: @Model.InWarehouseOrders | Đang giao: @Model.DeliveringOrders</small>
                    </div>
                    <div class="stat-icon-bg bg-warning-subtle text-warning">
                        <i class="bi bi-truck fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card stat-card shadow-sm border-0 border-start border-info border-4 p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Tổng người dùng</div>
                        <h3 class="fw-bold my-1 text-info">@Model.TotalUsers</h3>
                        <small class="text-muted">Khách: @Model.TotalCustomers | Nhân viên: @Model.TotalStaff</small>
                    </div>
                    <div class="stat-icon-bg bg-info-subtle text-info">
                        <i class="bi bi-people fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PHÂN PHỐI TRẠNG THÁI & MENU QUẢN LÝ NHANH -->
    <div class="row g-4 mb-4">
        
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Trạng Thái Tiến Độ Đơn Hàng</h5>
                    <a asp-action="Orders" class="btn btn-sm btn-link text-decoration-none">Xem tất cả <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="card-body">
                    <div class="row g-3 text-center">
                        <div class="col-sm-4 col-6">
                            <div class="p-3 bg-light rounded-3">
                                <div class="fs-4 fw-bold text-secondary">@Model.PendingReceptionOrders</div>
                                <span class="small text-muted">Chờ tiếp nhận</span>
                            </div>
                        </div>
                        <div class="col-sm-4 col-6">
                            <div class="p-3 bg-light rounded-3">
                                <div class="fs-4 fw-bold text-info">@Model.InWarehouseOrders</div>
                                <span class="small text-muted">Trong kho</span>
                            </div>
                        </div>
                        <div class="col-sm-4 col-6">
                            <div class="p-3 bg-light rounded-3">
                                <div class="fs-4 fw-bold text-warning">@Model.DeliveringOrders</div>
                                <span class="small text-muted">Đang giao hàng</span>
                            </div>
                        </div>
                        <div class="col-sm-4 col-6">
                            <div class="p-3 bg-light rounded-3">
                                <div class="fs-4 fw-bold text-success">@Model.CompletedOrders</div>
                                <span class="small text-muted">Đã giao thành công</span>
                            </div>
                        </div>
                        <div class="col-sm-4 col-6">
                            <div class="p-3 bg-light rounded-3">
                                <div class="fs-4 fw-bold text-danger">@Model.CancelledOrders</div>
                                <span class="small text-muted">Đã hủy / Thất bại</span>
                            </div>
                        </div>
                        <div class="col-sm-4 col-6">
                            <div class="p-3 bg-light rounded-3">
                                <div class="fs-4 fw-bold text-primary">@Model.TotalOrders</div>
                                <span class="small text-muted">Tổng đơn</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-grid-fill text-primary me-2"></i>Tính Năng Quản Lý</h5>
                </div>
                <div class="card-body p-3">
                    <div class="list-group list-group-flush">
                        <a asp-action="Users" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <div>
                                <i class="bi bi-person-gear text-primary fs-5 me-2"></i>
                                <strong>Quản lý tài khoản & Phân quyền</strong>
                            </div>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </a>
                        <a asp-action="Orders" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <div>
                                <i class="bi bi-card-checklist text-success fs-5 me-2"></i>
                                <strong>Quản lý toàn bộ đơn hàng</strong>
                            </div>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </a>
                        <a asp-controller="PriceTable" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <div>
                                <i class="bi bi-table text-warning fs-5 me-2"></i>
                                <strong>Quản lý bảng giá cước</strong>
                            </div>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </a>
                        <a asp-action="PackageTypes" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <div>
                                <i class="bi bi-tags text-info fs-5 me-2"></i>
                                <strong>Danh mục loại hàng hóa</strong>
                            </div>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ĐƠN HÀNG GẦN ĐÂY -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Đơn Hàng Gần Đây Cần Xử Lý</h5>
            <a asp-action="Orders" class="btn btn-sm btn-outline-primary">Xem tất cả đơn</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã đơn</th>
                            <th>Người gửi</th>
                            <th>Người nhận</th>
                            <th>Khoảng cách</th>
                            <th>Tổng cước</th>
                            <th>Ngày tạo</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentOrders == null || !Model.RecentOrders.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">Chưa có đơn hàng nào trong hệ thống.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="OrderDetails" asp-route-id="@order.OrderCode" class="fw-bold text-primary text-decoration-none">
                                            @order.OrderCode
                                        </a>
                                    </td>
                                    <td>
                                        <div>@order.SenderName</div>
                                        <small class="text-muted">@order.SenderPhone</small>
                                    </td>
                                    <td>
                                        <div>@order.ReceiverName</div>
                                        <small class="text-muted">@order.ReceiverPhone</small>
                                    </td>
                                    <td>@order.DistanceKm km</td>
                                    <td class="fw-bold text-success">@order.TotalAmount.ToString("N0") đ</td>
                                    <td class="small text-muted">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @{
                                            string badgeClass = order.CurrentStatus switch
                                            {
                                                "Chưa nhận" => "bg-secondary",
                                                "Đã nhận" or "Đã tiếp nhận" => "bg-info text-dark",
                                                "Trong kho" => "bg-primary",
                                                "Đang giao" => "bg-warning text-dark",
                                                "Đã giao" or "Giao thành công" => "bg-success",
                                                "Đã hủy" or "Giao thất bại" => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass">@order.CurrentStatus</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="OrderDetails" asp-route-id="@order.OrderCode" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
