@model DeliveryManagement.Models.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = "Chỉnh sửa tài khoản";
    var allRoles = ViewBag.AllRoles as List<string> ?? new List<string>();
}

<div class="container py-4">
    @await Html.PartialAsync("_AdminNavBar")
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-0 py-3">
                    <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-pencil-square me-2"></i>Chỉnh Sửa Tài Khoản & Phân Quyền</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="EditUser" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Email" />

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email (Tên đăng nhập)</label>
                            <input value="@Model.Email" class="form-control bg-light" readonly />
                            <small class="text-muted">Email đăng nhập không thể thay đổi.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Role" class="form-label fw-semibold">Vai trò phân quyền <span class="text-danger">*</span></label>
                            <select asp-for="Role" class="form-select">
                                @foreach (var r in allRoles)
                                {
                                    <option value="@r" selected="@(Model.Role == r)">@r</option>
                                }
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="NewPassword" class="form-label fw-semibold">Đổi mật khẩu mới (Nếu có)</label>
                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="Để trống nếu không muốn đổi mật khẩu" />
                            <small class="text-muted">Nhập mật khẩu mới chỉ khi bạn muốn đặt lại mật khẩu cho tài khoản này.</small>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Users" class="btn btn-outline-secondary">Quay lại</a>
                            <button type="submit" class="btn btn-primary-custom px-4">Lưu thay đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
