@model DeliveryManagement.Models.PriceTable

@{
    var isEdit = Model.PriceTableId != 0;
    ViewData["Title"] = isEdit ? "Sửa mức giá" : "Thêm mức giá";
}

<div class="order-create-page">

    <div class="order-create-header">
        <h1>@ViewData["Title"]</h1>
        <p>Mức giá áp dụng khi khối lượng đơn lớn hơn "Từ" và nhỏ hơn hoặc bằng "Đến"</p>
    </div>

    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="order-form" novalidate>

        <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>

        <input type="hidden" asp-for="PriceTableId" />

        <div class="order-section">

            <div class="form-group">
                <label asp-for="DeliveryMethod" class="form-label">Hình thức giao hàng</label>
                <select asp-for="DeliveryMethod" class="form-control">
                    <option value="Thường">Giao thường</option>
                    <option value="Nhanh">Giao nhanh</option>
                </select>
                <span asp-validation-for="DeliveryMethod" class="field-validation-error"></span>
            </div>

            <div class="order-form-grid">
                <div class="form-group">
                    <label asp-for="MinWeight" class="form-label">Từ khối lượng (kg)</label>
                    <input asp-for="MinWeight" type="number" min="0" step="0.01" class="form-control" />
                    <span asp-validation-for="MinWeight" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MaxWeight" class="form-label">Đến khối lượng (kg)</label>
                    <input asp-for="MaxWeight" type="number" min="0.01" step="0.01" class="form-control" />
                    <span asp-validation-for="MaxWeight" class="field-validation-error"></span>
                </div>
            </div>

            <div class="order-form-grid">
                <div class="form-group">
                    <label asp-for="Price" class="form-label">Giá (VNĐ)</label>
                    <input asp-for="Price" type="number" min="0" step="1000" class="form-control" />
                    <span asp-validation-for="Price" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DistanceRange" class="form-label">Ghi chú khoảng cách (không bắt buộc)</label>
                    <input asp-for="DistanceRange" data-val="false" class="form-control" placeholder="Ví dụ: Nội thành" />
                </div>
            </div>

        </div>

        <div class="order-form-actions">
            <a asp-action="Index" class="btn-cancel">Hủy</a>
            <button type="submit" class="btn-submit-order">Lưu</button>
        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}