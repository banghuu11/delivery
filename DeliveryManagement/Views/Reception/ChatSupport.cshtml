@model List<DeliveryManagement.Models.Conversation>
@{
    ViewData["Title"] = "Chat hỗ trợ khách hàng";
    var activeConv = ViewBag.ActiveConversation as DeliveryManagement.Models.Conversation;
}

<div class="container-fluid py-4 px-lg-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <div class="bg-info bg-opacity-10 text-info rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                    <i class="bi bi-chat-dots-fill fs-4"></i>
                </div>
                <div>
                    <h2 class="fw-bold mb-0">Hộp Thoại Hỗ Trợ Khách Hàng (CSKH)</h2>
                    <p class="text-muted small mb-0">Theo dõi câu hỏi khách hàng, phản hồi của AI và trực tiếp giải đáp thắc mắc (Story 11.0 - Tiếp nhận)</p>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách đơn
            </a>
            <a asp-action="ChatSupport" class="btn btn-outline-primary">
                <i class="bi bi-arrow-clockwise me-1"></i> Làm mới hội thoại
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- DANH SÁCH CUỘC HỘI THOẠI BÊN TRÁI -->
        <div class="col-lg-4 col-md-5">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-chat-left-text me-2 text-primary"></i>Danh sách phiên chat</span>
                    <span class="badge bg-primary rounded-pill">@(Model?.Count ?? 0)</span>
                </div>
                <div class="list-group list-group-flush overflow-auto" style="max-height: 600px;">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-chat-square-quote fs-1 opacity-50 d-block mb-2"></i>
                            Chưa có cuộc trò chuyện nào từ khách hàng.
                        </div>
                    }
                    else
                    {
                        @foreach (var c in Model)
                        {
                            var isSelected = activeConv != null && activeConv.ConversationId == c.ConversationId;
                            var lastMsg = c.Messages.OrderByDescending(m => m.SentAt).FirstOrDefault();
                            var customerName = c.Customer?.FullName ?? c.Customer?.Email ?? "Khách vãng lai";

                            <a asp-action="ChatSupport" asp-route-id="@c.ConversationId"
                               class="list-group-item list-group-item-action p-3 @(isSelected ? "bg-light border-start border-primary border-4" : "")">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h6 class="fw-bold mb-0 text-truncate text-dark" style="max-width: 170px;">
                                        @customerName
                                    </h6>
                                    <small class="text-muted" style="font-size: 0.75rem;">
                                        @(lastMsg != null ? lastMsg.SentAt.ToString("HH:mm dd/MM") : c.CreatedAt.ToString("HH:mm dd/MM"))
                                    </small>
                                </div>
                                <p class="text-muted small mb-2 text-truncate" style="max-width: 260px;">
                                    @(lastMsg != null ? lastMsg.Content : "Bắt đầu cuộc trò chuyện")
                                </p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge @(c.Status == "Open" ? "bg-warning text-dark" : "bg-success") rounded-pill">
                                        @(c.Status == "Open" ? "Đang mở" : "Đã phản hồi")
                                    </span>
                                    <span class="badge bg-light text-muted border">
                                        @c.Messages.Count tin nhắn
                                    </span>
                                </div>
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- CHI TIẾT TIN NHẮN & KHUNG PHẢN HỒI BÊN PHẢI -->
        <div class="col-lg-8 col-md-7">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden d-flex flex-column" style="height: 660px;">
                @if (activeConv == null)
                {
                    <div class="text-center my-auto py-5 text-muted">
                        <i class="bi bi-chat-dots fs-1 opacity-50 d-block mb-3"></i>
                        Vui lòng chọn một cuộc trò chuyện ở danh sách bên trái để xem nội dung.
                    </div>
                }
                else
                {
                    var cust = activeConv.Customer;
                    <!-- HEADER PHIÊN CHAT -->
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-person-fill fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">@(cust?.FullName ?? "Khách vãng lai")</h6>
                                <small class="text-muted">Email: @(cust?.Email ?? "N/A") | SĐT: @(cust?.PhoneNumber ?? "Chưa cập nhật")</small>
                            </div>
                        </div>
                        <div>
                            <span class="badge bg-light text-secondary border">Phiên #@activeConv.ConversationId</span>
                        </div>
                    </div>

                    <!-- NỘI DUNG TIN NHẮN (THREAD) -->
                    <div class="card-body p-3 overflow-auto flex-grow-1 bg-light bg-opacity-25" id="staffChatThread">
                        @if (!activeConv.Messages.Any())
                        {
                            <div class="text-center py-5 text-muted">Chưa có tin nhắn trong phiên này.</div>
                        }
                        else
                        {
                            @foreach (var m in activeConv.Messages.OrderBy(msg => msg.SentAt))
                            {
                                bool isCustomer = m.SenderId == activeConv.CustomerId;
                                bool isAi = m.Sender?.Email == "ai-assistant@delivery.com";

                                <div class="d-flex mb-3 @(isCustomer ? "justify-content-start" : "justify-content-end")">
                                    <div class="card border-0 shadow-sm" style="max-width: 80%; @(isCustomer ? "background: #ffffff;" : isAi ? "background: #eef2ff;" : "background: #fef3c7;")">
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center justify-content-between gap-3 mb-1">
                                                <strong class="small @(isCustomer ? "text-primary" : isAi ? "text-indigo" : "text-warning text-dark")">
                                                    @if (isCustomer)
                                                    {
                                                        <span><i class="bi bi-person me-1"></i> @(cust?.FullName ?? "Khách hàng")</span>
                                                    }
                                                    else if (isAi)
                                                    {
                                                        <span><i class="bi bi-robot me-1 text-primary"></i> Trợ lý AI Tốc Độ</span>
                                                    }
                                                    else
                                                    {
                                                        <span><i class="bi bi-headset me-1 text-danger"></i> @(m.Sender?.FullName ?? "Nhân viên tiếp nhận")</span>
                                                    }
                                                </strong>
                                                <small class="text-muted" style="font-size: 0.7rem;">@m.SentAt.ToString("HH:mm - dd/MM")</small>
                                            </div>
                                            <div class="small text-dark" style="white-space: pre-line;">@m.Content</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <!-- FOOTER NHÂN VIÊN PHẢN HỒI -->
                    <div class="card-footer bg-white p-3 border-top">
                        <form asp-action="StaffReply" method="post" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="conversationId" value="@activeConv.ConversationId" />
                            <textarea name="content" class="form-control" rows="2" placeholder="Nhập câu trả lời của nhân viên tiếp nhận gửi đến khách hàng..." required></textarea>
                            <button type="submit" class="btn btn-primary-custom px-4 d-flex align-items-center gap-1">
                                <i class="bi bi-send-fill"></i> Gửi
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // Tự động cuộn xuống tin nhắn cuối cùng
        const chatBox = document.getElementById('staffChatThread');
        if (chatBox) {
            chatBox.scrollTop = chatBox.scrollHeight;
        }
    </script>
}
