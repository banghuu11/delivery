@model DeliveryManagement.Models.ViewModels.ReceptionViewModel

@{
    var isReadOnly = ViewBag.IsReadOnly is bool readOnly && readOnly;

    ViewData["Title"] = isReadOnly
        ? "Xem thông tin đơn hàng"
        : "Ghi nhận thông tin đơn hàng";
}

<div class="container mt-4 mb-5">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="mb-1">
                @(isReadOnly ? "Xem thông tin đơn hàng" : "Ghi nhận thông tin đơn hàng")
            </h2>

            <p class="text-muted mb-0">
                Mã đơn: <strong>@Model.OrderCode</strong>
            </p>

            @if (isReadOnly)
            {
                <span class="badge bg-success mt-2">
                    <i class="bi bi-check-circle me-1"></i>
                    Đơn hàng đã được ghi nhận
                </span>
            }
            else
            {
                <span class="badge bg-warning text-dark mt-2">
                    Chưa ghi nhận
                </span>
            }
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại danh sách
        </a>
    </div>

    @if (isReadOnly)
    {
        @* =========================================
           CHẾ ĐỘ CHỈ XEM - ĐƠN ĐÃ GHI NHẬN
           Không hiển thị form chỉnh sửa.
           ========================================= *@

        <div class="alert alert-info">
            <i class="bi bi-info-circle me-1"></i>
            Đơn hàng này đã được ghi nhận. Thông tin bên dưới chỉ dành cho việc xem lại.
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white fw-bold">
                1. Thông tin người nhận
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label text-muted">Họ và tên</label>
                        <div class="form-control-plaintext fw-semibold border-bottom">
                            @(Model.ReceiverName ?? "Chưa có thông tin")
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-muted">Số điện thoại</label>
                        <div class="form-control-plaintext fw-semibold border-bottom">
                            @(Model.ReceiverPhone ?? "Chưa có thông tin")
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label text-muted">Địa chỉ</label>
                        <div class="form-control-plaintext border-bottom">
                            @(Model.ReceiverAddress ?? "Chưa có thông tin")
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white fw-bold">
                2. Thông tin hàng hóa
            </div>

            <div class="card-body">

                @if (Model.Items != null && Model.Items.Any())
                {
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        var item = Model.Items[i];

                        <div class="border rounded p-3 mb-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                <h5 class="mb-0">Hàng hóa @(i + 1)</h5>
                                <span class="badge bg-light text-dark border">
                                    @(item.PackageTypeName ?? "Chưa phân loại")
                                </span>
                            </div>

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label class="form-label text-muted">
                                        Mô tả hàng hóa
                                    </label>
                                    <div class="form-control-plaintext border-bottom">
                                        @(string.IsNullOrWhiteSpace(item.Description)
                                                                    ? "Không có mô tả"
                                                                    : item.Description)
                                                                                   </div>
                                                                               </div>

                                <div class="col-md-6">
                                    <label class="form-label text-muted">
                                        Kích thước
                                    </label>
                                    <div class="form-control-plaintext border-bottom">
                                        @(string.IsNullOrWhiteSpace(item.Size)
                                                                    ? "Chưa có thông tin"
                                                                    : item.Size)
                        </div>
                    </div>

                                <div class="col-md-6">
                                    <label class="form-label text-muted">
                                        Số lượng
                                    </label>
                                    <div class="form-control-plaintext border-bottom">
                                        @item.Quantity
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label text-muted">
                                        Khối lượng mỗi món
                                    </label>
                                    <div class="form-control-plaintext border-bottom">
                                        @item.Weight.ToString("0.##") kg
                                    </div>
                                </div>

                                <div class="col-12 d-flex flex-wrap gap-2">
                        @if (item.IsFragile)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                            Hàng dễ vỡ
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Không dễ vỡ
                                        </span>
                                    }

                                    @if (item.IsValuable)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-gem me-1"></i>
                                            Hàng có giá trị
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Hàng thường
                                        </span>
                                    }
                                </div>

                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        Chưa có thông tin hàng hóa.
                    </div>
                }
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white fw-bold">
            3. Ghi chú tiếp nhận
        </div>

        <div class="card-body">
            <div class="form-control-plaintext"
                 style="white-space: pre-wrap;">
                @(string.IsNullOrWhiteSpace(Model.ReceptionNote)
                                ? "Không có ghi chú."
                                : Model.ReceptionNote)
            </div>
        </div>
    </div>

        @* Chỉ có nút xem và in, không có nút lưu hoặc ghi nhận. *@

        <div class="d-flex flex-wrap justify-content-end gap-2">
            <a asp-controller="DeliveryOrder"
               asp-action="Details"
               asp-route-id="@Model.OrderCode"
               class="btn btn-outline-primary">
                <i class="bi bi-eye me-1"></i>
                Xem chi tiết đơn hàng
            </a>

            <a asp-controller="DeliveryOrder"
               asp-action="PrintWaybill"
               asp-route-id="@Model.OrderCode"
               target="_blank"
               class="btn btn-primary">
                <i class="bi bi-printer me-1"></i>
                In phiếu gửi hàng
            </a>
        </div>
        }
    else
    {
        @* =========================================
           CHẾ ĐỘ GHI NHẬN - ĐƠN CHƯA GHI NHẬN
           ========================================= *@

        <form asp-action="Record"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="OrderCode" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white fw-bold">
                    1. Thông tin người nhận
                </div>

                <div class="card-body">
                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label asp-for="ReceiverName"
                                   class="form-label fw-semibold">
                                Họ và tên
                            </label>

                            <input asp-for="ReceiverName"
                                   class="form-control" />

                            <span asp-validation-for="ReceiverName"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ReceiverPhone"
                                   class="form-label fw-semibold">
                                Số điện thoại
                            </label>

                            <input asp-for="ReceiverPhone"
                                   class="form-control" />

                            <span asp-validation-for="ReceiverPhone"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-12 mb-0">
                            <label asp-for="ReceiverAddress"
                                   class="form-label fw-semibold">
                                Địa chỉ
                            </label>

                            <input asp-for="ReceiverAddress"
                                   class="form-control" />

                            <span asp-validation-for="ReceiverAddress"
                                  class="text-danger"></span>
                        </div>

                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white fw-bold">
                    2. Thông tin hàng hóa
                </div>

                <div class="card-body">

                    @if (Model.Items != null)
                    {
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            <div class="border rounded p-3 mb-3">

                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                    <h5 class="mb-0">Hàng hóa @(i + 1)</h5>

                                    <span class="badge bg-light text-dark border">
                                        @Model.Items[i].PackageTypeName
                                    </span>
                                </div>

                                <input asp-for="Items[i].OrderItemId"
                                       type="hidden" />

                                <input asp-for="Items[i].PackageTypeId"
                                       type="hidden" />

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">
                                        Loại hàng khách khai báo
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           value="@Model.Items[i].PackageTypeName"
                                           disabled />

                                    <div class="form-text">
                                        Nhân viên tiếp nhận không thay đổi loại hàng tại bước này.
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Items[i].Description"
                                           class="form-label fw-semibold">
                                        Mô tả hàng hóa
                                    </label>

                                    <textarea asp-for="Items[i].Description"
                                              class="form-control"
                                              rows="2"
                                              placeholder="Nhập nếu cần bổ sung thông tin"></textarea>

                                    <span asp-validation-for="Items[i].Description"
                                          class="text-danger"></span>
                                </div>

                                <div class="row">

                                    <div class="col-md-4 mb-3">
                                        <label asp-for="Items[i].Size"
                                               class="form-label fw-semibold">
                                            Kích thước
                                        </label>

                                        <input asp-for="Items[i].Size"
                                               class="form-control" />

                                        <span asp-validation-for="Items[i].Size"
                                              class="text-danger"></span>
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label asp-for="Items[i].Quantity"
                                               class="form-label fw-semibold">
                                            Số lượng
                                        </label>

                                        <input asp-for="Items[i].Quantity"
                                               type="number"
                                               min="1"
                                               max="1000"
                                               class="form-control" />

                                        <span asp-validation-for="Items[i].Quantity"
                                              class="text-danger"></span>
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label asp-for="Items[i].Weight"
                                               class="form-label fw-semibold">
                                            Khối lượng mỗi món (kg)
                                        </label>

                                        <input asp-for="Items[i].Weight"
                                               type="number"
                                               min="0.01"
                                               max="10000"
                                               step="0.01"
                                               class="form-control" />

                                        <span asp-validation-for="Items[i].Weight"
                                              class="text-danger"></span>
                                    </div>

                                </div>

                                <div class="d-flex flex-wrap gap-4">

                                    <div class="form-check">
                                        <input asp-for="Items[i].IsFragile"
                                               class="form-check-input" />

                                        <label asp-for="Items[i].IsFragile"
                                               class="form-check-label">
                                            Hàng dễ vỡ
                                        </label>
                                    </div>

                                    <div class="form-check">
                                        <input asp-for="Items[i].IsValuable"
                                               class="form-check-input" />

                                        <label asp-for="Items[i].IsValuable"
                                               class="form-check-label">
                                            Hàng có giá trị
                                        </label>
                                    </div>

                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white fw-bold">
                    3. Ghi chú tiếp nhận
                </div>

                <div class="card-body">
                    <label asp-for="ReceptionNote"
                           class="form-label">
                        Ghi chú
                    </label>

                    <textarea asp-for="ReceptionNote"
                              class="form-control"
                              rows="4"
                              placeholder="Ví dụ: Đã đối chiếu thông tin người nhận và kiểm tra hàng hóa thực tế."></textarea>

                    <span asp-validation-for="ReceptionNote"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-end gap-2">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Hủy
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i>
                    Ghi nhận thông tin
                </button>
            </div>

        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}