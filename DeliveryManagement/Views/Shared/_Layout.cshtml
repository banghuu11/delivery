@using DeliveryManagement.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ApplicationUser? currentUser = null;
    IList<string> currentRoles = new List<string>();

    if (User.Identity?.IsAuthenticated == true)
    {
        currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null)
        {
            currentRoles = await UserManager.GetRolesAsync(currentUser);
        }
    }
    string primaryRole = currentRoles.FirstOrDefault() ?? "Customer";

    string currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
    bool isAdminArea =
        (currentController == "Admin" ||
         currentController == "PriceTable" ||
         currentController == "Station" ||
         currentController == "Reviews")
        && User.IsInRole("Admin");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TỐC ĐỘ DELIVERY</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="d-flex flex-column min-vh-100">

    <header class="sticky-top">
        <nav class="navbar navbar-expand-xl app-navbar shadow-sm bg-white py-2 @(isAdminArea ? "border-bottom border-warning border-3" : "")">
            <div class="container-fluid px-3 px-xl-4">

                <!-- BRAND LOGO -->
                <a class="navbar-brand d-flex align-items-center me-2 me-xl-4" asp-controller="@(isAdminArea ? "Admin" : "Home")" asp-action="Index">
                    <div class="brand-logo-container">
                        <span class="logo-speed-lines"><i class="bi bi-wind"></i></span>
                        <div class="d-inline-block">
                            <span class="logo-text-bold">TỐC ĐỘ</span>
                            <span class="logo-text-sub">DELIVERY</span>
                        </div>
                    </div>
                </a>

                <button class="navbar-toggler border-0 shadow-none px-2"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-dark"></i>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- MENU ĐIỀU HƯỚNG LINH HOẠT (DYNAMIC NAVBAR) -->
                    @if (isAdminArea)
                    {
                        <!-- ===== MENU DÀNH CHO KHU VỰC QUẢN TRỊ ADMIN (TỐI ƯU 4 NHÓM) ===== -->
                        <ul class="navbar-nav me-auto mb-2 mb-xl-0 fw-semibold align-items-xl-center gap-xl-1">
                            
                            <!-- 1. Dashboard -->
                            <li class="nav-item">
                                <a class="nav-link px-2 px-xl-3 text-nowrap @(currentController == "Admin" && currentAction == "Index" ? "active text-orange fw-bold" : "")" 
                                   asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>

                            <!-- 2. Vận hành (Đơn hàng, Đánh giá, Tiếp nhận, Kho bãi) -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle px-2 px-xl-3 text-nowrap @((currentController == "Admin" && (currentAction == "Orders" || currentAction == "OrderDetails")) || currentController == "Reviews" || currentController == "Reception" || currentController == "Warehouse" ? "active text-orange fw-bold" : "")" 
                                   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-box-seam me-1"></i> Vận hành
                                </a>
                                <ul class="dropdown-menu shadow border-0 py-2 rounded-3">
                                    <li>
                                        <a class="dropdown-item py-2 @(currentController == "Admin" && (currentAction == "Orders" || currentAction == "OrderDetails") ? "active fw-bold text-orange" : "")" 
                                           asp-controller="Admin" asp-action="Orders">
                                            <i class="bi bi-box-seam-fill me-2 text-primary"></i> Quản lý đơn hàng
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 @(currentController == "Reviews" ? "active fw-bold text-orange" : "")" 
                                           asp-controller="Reviews" asp-action="Index">
                                            <i class="bi bi-star-fill me-2 text-warning"></i> Quản lý đánh giá
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header text-uppercase text-muted small fw-bold">Điều phối logistics</h6></li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Reception" asp-action="Index">
                                            <i class="bi bi-inboxes-fill me-2 text-info"></i> Khu vực tiếp nhận
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Warehouse" asp-action="Index">
                                            <i class="bi bi-building-fill me-2 text-success"></i> Khu vực kho bãi
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <!-- 3. Cấu hình & Bưu cục (Bưu cục, Loại hàng, Bảng giá & Thời tiết) -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle px-2 px-xl-3 text-nowrap @(currentController == "Station" || (currentController == "Admin" && currentAction == "PackageTypes") || currentController == "PriceTable" ? "active text-orange fw-bold" : "")" 
                                   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-sliders me-1"></i> Cấu hình
                                </a>
                                <ul class="dropdown-menu shadow border-0 py-2 rounded-3">
                                    <li>
                                        <a class="dropdown-item py-2 @(currentController == "Station" ? "active fw-bold text-orange" : "")" 
                                           asp-controller="Station" asp-action="Index">
                                            <i class="bi bi-geo-alt-fill me-2 text-danger"></i> Mạng lưới bưu cục & bản đồ
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 @(currentController == "Admin" && currentAction == "PackageTypes" ? "active fw-bold text-orange" : "")" 
                                           asp-controller="Admin" asp-action="PackageTypes">
                                            <i class="bi bi-tags-fill me-2 text-secondary"></i> Danh mục loại hàng
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header text-uppercase text-muted small fw-bold">Bảng giá & Phụ phí</h6></li>
                                    <li>
                                        <a class="dropdown-item py-2 @(currentController == "PriceTable" && currentAction == "Policy" ? "active fw-bold text-orange" : "")" 
                                           asp-controller="PriceTable" asp-action="Policy">
                                            <i class="bi bi-cloud-sun me-2 text-warning"></i> Giá động (Thời tiết & Giao thông)
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 @(currentController == "PriceTable" && currentAction == "Index" ? "active fw-bold text-orange" : "")" 
                                           asp-controller="PriceTable" asp-action="Index">
                                            <i class="bi bi-table me-2 text-success"></i> Bảng giá cước bậc thang
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <!-- 4. Hệ thống (Tài khoản & Phân quyền) -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle px-2 px-xl-3 text-nowrap @(currentController == "Admin" && (currentAction == "Users" || currentAction == "UserDetails" || currentAction == "CreateUser" || currentAction == "EditUser" || currentAction == "Roles") ? "active text-orange fw-bold" : "")" 
                                   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock me-1"></i> Hệ thống
                                </a>
                                <ul class="dropdown-menu shadow border-0 py-2 rounded-3">
                                    <li>
                                        <a class="dropdown-item py-2 @(currentController == "Admin" && (currentAction == "Users" || currentAction == "UserDetails" || currentAction == "CreateUser" || currentAction == "EditUser") ? "active fw-bold text-orange" : "")" 
                                           asp-controller="Admin" asp-action="Users">
                                            <i class="bi bi-people-fill me-2 text-primary"></i> Quản lý tài khoản
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 @(currentController == "Admin" && currentAction == "Roles" ? "active fw-bold text-orange" : "")" 
                                           asp-controller="Admin" asp-action="Roles">
                                            <i class="bi bi-shield-shaded me-2 text-success"></i> Ma trận phân quyền
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <!-- ===== MENU DÀNH CHO KHÁCH HÀNG & GIAO DIỆN CÔNG KHAI ===== -->
                        <ul class="navbar-nav me-auto mb-2 mb-xl-0 fw-semibold">
                            <li class="nav-item">
                                <a class="nav-link px-3 text-nowrap" href="/#services">
                                    Dịch vụ
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link px-3 text-nowrap" href="/#pricing">
                                    Giá cả
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link px-3 text-nowrap" asp-controller="Home" asp-action="Track">
                                    Theo dõi
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link px-3 text-nowrap @(currentController == "Home" && currentAction == "Stations" ? "active text-orange fw-bold" : "")" asp-controller="Home" asp-action="Stations">
                                    <i class="bi bi-geo-alt-fill text-orange me-1"></i> Bưu cục & Bản đồ
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link px-3 text-nowrap" href="#contact">
                                    Liên hệ
                                </a>
                            </li>
                        </ul>
                    }

                    <!-- MENU BÊN PHẢI (USER & CTA) -->
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3 mt-xl-0 pt-2 pt-xl-0">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (isAdminArea)
                            {
                                <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 shadow-none fw-semibold d-flex align-items-center" target="_blank" title="Xem trang chủ">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>
                                    <span class="d-none d-xxl-inline">Xem </span>Website
                                </a>
                            }
                            else
                            {
                                @if (User.IsInRole("Customer"))
                                {
                                    <a asp-controller="DeliveryOrder" asp-action="Create" class="btn btn-tocdo-orange rounded-pill px-4 shadow-sm fw-bold">
                                        Gửi Đơn Ngay
                                    </a>
                                }
                                else if (User.IsInRole("Admin"))
                                {
                                    <a asp-controller="Admin" asp-action="Index" class="btn btn-tocdo-orange rounded-pill px-4 shadow-sm fw-bold">
                                        Trang Quản Trị
                                    </a>
                                }
                                else if (User.IsInRole("ReceptionStaff"))
                                {
                                    <a asp-controller="Reception" asp-action="Index" class="btn btn-tocdo-orange rounded-pill px-4 shadow-sm fw-bold">
                                        Khu Vực Tiếp Nhận
                                    </a>
                                }
                                else if (User.IsInRole("WarehouseStaff"))
                                {
                                    <a asp-controller="Warehouse" asp-action="Index" class="btn btn-tocdo-orange rounded-pill px-4 shadow-sm fw-bold">
                                        Khu Vực Kho
                                    </a>
                                }
                                else if (User.IsInRole("DeliveryStaff"))
                                {
                                    <a asp-controller="DeliveryStaff" asp-action="Index"
                                       class="btn btn-tocdo-orange rounded-pill px-4 shadow-sm fw-bold">
                                        Khu Vực Giao Hàng
                                    </a>
                                }
                            }

                            <!-- DROPDOWN USER -->
                            <div class="dropdown ms-xl-2">
                                <a class="nav-link dropdown-toggle user-pill d-flex align-items-center p-1 pe-2"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <div class="user-avatar-sm me-2 bg-orange text-white">
                                        @(currentUser?.FullName?.FirstOrDefault() ?? 'U')
                                    </div>
                                    <div class="text-start d-block" style="max-width: 125px;">
                                        <div class="user-name text-truncate">@(string.IsNullOrWhiteSpace(currentUser?.FullName) ? User.Identity?.Name : currentUser.FullName)</div>
                                    </div>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2">
                                    <li class="px-3 py-2 border-bottom">
                                        <div class="fw-bold text-truncate">@currentUser?.FullName</div>
                                        <small class="text-muted text-truncate d-block">@currentUser?.Email</small>
                                    </li>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Bảng điều khiển Admin</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-2"></i>Quản lý người dùng</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Roles"><i class="bi bi-shield-shaded me-2"></i>Ma trận phân quyền</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Orders"><i class="bi bi-box-seam me-2"></i>Quản lý đơn hàng</a></li>
                                    }
                                    @if (User.IsInRole("ReceptionStaff") )
                                    {
                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-controller="Reviews"
                                               asp-action="Index">
                                                <i class="bi bi-star-fill me-2 text-warning"></i>
                                                Quản lý đánh giá
                                            </a>
                                        </li>
                                    }
                                    @if (User.IsInRole("Customer"))
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="DeliveryOrder" asp-action="Index"><i class="bi bi-box-seam me-2"></i>Đơn hàng của tôi</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Sender" asp-action="Index"><i class="bi bi-person-vcard me-2"></i>Thông tin người gửi</a></li>
                                    }
                                    else
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="Sender" asp-action="Index"><i class="bi bi-person-vcard me-2"></i>Thông tin tài khoản</a></li>
                                    }

                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item text-danger py-2">
                                                <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary rounded-pill px-3 py-2 me-1 small fw-semibold">
                                Đăng nhập
                            </a>
                            <a asp-controller="DeliveryOrder" asp-action="Create" class="btn btn-tocdo-orange rounded-pill px-4 shadow-sm fw-bold">
                                Gửi Đơn Ngay
                            </a>
                        }

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- FOOTER CHUYÊN NGHIỆP -->
    <footer id="contact" class="app-footer bg-dark text-white pt-5 pb-3 mt-auto">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center mb-3">
                        <div class="logo-speed-lines text-orange fs-2 me-2">
                            <i class="bi bi-wind"></i>
                        </div>
                        <h4 class="fw-bold mb-0 text-white">TỐC ĐỘ <span class="text-orange">DELIVERY</span></h4>
                    </div>
                    <p class="text-secondary small">
                        Hệ thống vận chuyển hỏa tốc thông minh, tin cậy. Cam kết giao nhận an toàn, đúng giờ và hỗ trợ khách hàng 24/7 trên toàn quốc.
                    </p>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white fw-bold mb-3">Liên Kết Nhanh</h6>
                    <ul class="list-unstyled footer-links small">
                        <li><a href="/#services">Dịch vụ</a></li>
                        <li><a href="/#pricing">Bảng giá</a></li>
                        <li><a asp-controller="Home" asp-action="Track">Theo dõi đơn</a></li>
                        <li><a asp-controller="DeliveryOrder" asp-action="Create">Gửi đơn ngay</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white fw-bold mb-3">Nghiệp Vụ</h6>
                    <ul class="list-unstyled footer-links small">
                        <li><a asp-controller="Reception" asp-action="Index">Tiếp nhận</a></li>
                        <li><a asp-controller="Warehouse" asp-action="Index">Kho bãi</a></li>
                        <li><a asp-controller="Admin" asp-action="Index">Khu vực Admin</a></li>
                        <li><a asp-controller="PriceTable" asp-action="Index">Bảng giá cước</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Thông Tin Liên Hệ</h6>
                    <ul class="list-unstyled text-secondary small">
                        <li class="mb-2"><i class="bi bi-geo-alt text-orange me-2"></i>Trụ sở: TP. Hồ Chí Minh, Việt Nam</li>
                        <li class="mb-2"><i class="bi bi-telephone text-orange me-2"></i>Hotline: 1900 8888 (24/7)</li>
                        <li class="mb-2"><i class="bi bi-envelope text-orange me-2"></i>Email: hotro@tocdondelivery.vn</li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary my-4" />

            <div class="text-center text-secondary small">
                &copy; 2026 TỐC ĐỘ DELIVERY - All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>