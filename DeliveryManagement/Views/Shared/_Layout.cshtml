@using DeliveryManagement.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ApplicationUser? currentUser = null;
    IList<string> currentRoles = new List<string>();

    if (User.Identity?.IsAuthenticated == true)
    {
        currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null)
        {
            currentRoles = await UserManager.GetRolesAsync(currentUser);
        }
    }
    string primaryRole = currentRoles.FirstOrDefault() ?? "Customer";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Delivery Management</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg app-navbar shadow-sm">
            <div class="container-fluid px-lg-4">

                <!-- BRAND LOGO -->
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon me-2">
                        <i class="bi bi-truck-flatbed"></i>
                    </div>
                    <span class="brand-text">FastShip <small class="brand-badge">Logistics</small></span>
                </a>

                <button class="navbar-toggler border-0"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- MENU CHÍNH BÊN TRÁI -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Trang chủ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Track">
                                <i class="bi bi-geo-alt me-1"></i> Tra cứu đơn
                            </a>
                        </li>

                        <!-- DÀNH CHO ADMIN -->
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-primary fw-bold" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-speedometer2 me-1"></i> Quản trị Admin
                                </a>
                                <ul class="dropdown-menu shadow border-0">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-graph-up me-2 text-primary"></i>Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-2 text-info"></i>Quản lý tài khoản & Phân quyền</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Orders"><i class="bi bi-card-checklist me-2 text-success"></i>Tất cả đơn hàng</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="PriceTable" asp-action="Index"><i class="bi bi-table me-2 text-warning"></i>Bảng giá cước</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="PackageTypes"><i class="bi bi-tags me-2 text-secondary"></i>Loại hàng hóa</a></li>
                                </ul>
                            </li>
                        }

                        <!-- DÀNH CHO TIẾP NHẬN -->
                        @if (User.IsInRole("ReceptionStaff") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reception" asp-action="Index">
                                    <i class="bi bi-inboxes me-1"></i> Tiếp nhận đơn
                                </a>
                            </li>
                        }

                        <!-- DÀNH CHO NHÂN VIÊN KHO -->
                        @if (User.IsInRole("WarehouseStaff") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Warehouse" asp-action="Index">
                                    <i class="bi bi-building me-1"></i> Quản lý kho
                                </a>
                            </li>
                        }

                        <!-- DÀNH CHO KHÁCH HÀNG -->
                        @if (User.IsInRole("Customer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DeliveryOrder" asp-action="Create">
                                    <i class="bi bi-plus-circle me-1"></i> Tạo đơn hàng
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DeliveryOrder" asp-action="Index">
                                    <i class="bi bi-box-seam me-1"></i> Đơn của tôi
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- MENU USER BÊN PHẢI -->
                    <ul class="navbar-nav align-items-lg-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle user-pill d-flex align-items-center"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <div class="user-avatar-sm me-2">
                                        @(currentUser?.FullName?.FirstOrDefault() ?? 'U')
                                    </div>
                                    <div class="text-start d-none d-sm-block">
                                        <div class="user-name">@(string.IsNullOrWhiteSpace(currentUser?.FullName) ? User.Identity?.Name : currentUser.FullName)</div>
                                        <small class="user-role-badge badge-@primaryRole.ToLower()">@primaryRole</small>
                                    </div>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2">
                                    <li class="px-3 py-2 border-bottom">
                                        <div class="fw-bold">@currentUser?.FullName</div>
                                        <small class="text-muted">@currentUser?.Email</small>
                                    </li>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Bảng điều khiển Admin</a></li>
                                    }
                                    @if (User.IsInRole("Customer"))
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="DeliveryOrder" asp-action="Index"><i class="bi bi-box-seam me-2"></i>Đơn hàng của tôi</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="DeliveryOrder" asp-action="Create"><i class="bi bi-plus-circle me-2"></i>Tạo đơn giao hàng</a></li>
                                    }

                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item text-danger py-2">
                                                <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                                </a>
                            </li>

                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-primary-custom btn-sm px-3" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Đăng ký
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- FOOTER CHUYÊN NGHIỆP -->
    <footer class="app-footer bg-dark text-white pt-5 pb-3 mt-auto">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center mb-3">
                        <div class="brand-icon me-2 bg-primary text-white p-2 rounded">
                            <i class="bi bi-truck-flatbed fs-4"></i>
                        </div>
                        <h4 class="fw-bold mb-0">FastShip <span class="text-primary">Delivery</span></h4>
                    </div>
                    <p class="text-secondary small">
                        Hệ thống điều phối và quản lý giao nhận hàng hóa thông minh, minh bạch, hỗ trợ tối ưu chặng giao hàng từ tiếp nhận, lưu kho đến giao tận tay người nhận.
                    </p>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white fw-bold mb-3">Khách Hàng</h6>
                    <ul class="list-unstyled footer-links small">
                        <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li><a asp-controller="Home" asp-action="Track">Tra cứu hành trình</a></li>
                        <li><a asp-controller="DeliveryOrder" asp-action="Create">Tạo đơn hàng</a></li>
                        <li><a asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white fw-bold mb-3">Nghiệp Vụ</h6>
                    <ul class="list-unstyled footer-links small">
                        <li><a asp-controller="Reception" asp-action="Index">Tiếp nhận đơn</a></li>
                        <li><a asp-controller="Warehouse" asp-action="Index">Phân loại kho</a></li>
                        <li><a asp-controller="Admin" asp-action="Index">Khu vực Admin</a></li>
                        <li><a asp-controller="PriceTable" asp-action="Index">Bảng giá cước</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Thông Tin Liên Hệ</h6>
                    <ul class="list-unstyled text-secondary small">
                        <li class="mb-2"><i class="bi bi-geo-alt text-primary me-2"></i>Trụ sở: TP. Hồ Chí Minh, Việt Nam</li>
                        <li class="mb-2"><i class="bi bi-telephone text-primary me-2"></i>Hotline: 1900 6868 (24/7)</li>
                        <li class="mb-2"><i class="bi bi-envelope text-primary me-2"></i>Email: support@delivery.com</li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary my-4" />

            <div class="text-center text-secondary small">
                &copy; 2026 FastShip Delivery Management System. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>