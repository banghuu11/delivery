<!-- FLOATING AI ASSISTANT LAUNCHER (ICON BÊN PHẢI DƯỚI CÙNG) -->
<div id="tocdo-ai-chat-launcher" title="Chat với Trợ lý AI Tốc Độ 24/7" onclick="window.toggleAiChatBox && window.toggleAiChatBox(event)">
    <div class="ai-launcher-btn">
        <div class="ai-pulse-ring" style="pointer-events: none;"></div>
        <i class="bi bi-robot" style="pointer-events: none;"></i>
        <span class="ai-launcher-badge" style="pointer-events: none;">AI</span>
    </div>
</div>

<!-- KHUNG CHATBOX POPUP XUẤT HIỆN TẠI GÓC PHẢI DƯỚI CÙNG -->
<div id="tocdo-ai-chat-box" style="display: none;">
    <!-- HEADER -->
    <div class="ai-chat-header">
        <div class="d-flex align-items-center gap-2">
            <div class="ai-chat-header-avatar">
                <i class="bi bi-robot"></i>
                <div class="ai-online-dot"></div>
            </div>
            <div>
                <div class="fw-bold fs-6 mb-0 text-white">Trợ Lý AI Tốc Độ</div>
                <div class="small text-white-50" style="font-size: 0.72rem;">Hỗ trợ thông minh 24/7 • Sẵn sàng</div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-1">
            <button type="button" id="aiToggleCalcBtn" class="ai-chat-header-btn" title="Ước tính cước nhanh">
                <i class="bi bi-calculator"></i>
            </button>
            <button type="button" id="aiChatCloseBtn" class="ai-chat-header-btn" title="Đóng chatbox" onclick="window.toggleAiChatBox && window.toggleAiChatBox(event)">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <!-- MINI QUICK CALCULATOR (CÔNG CỤ TÍNH CƯỚC NHANH TRỰC TIẾP TRONG CHAT) -->
    <div id="ai-mini-calculator" style="display: none;">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="small fw-bold text-dark"><i class="bi bi-calculator-fill text-primary me-1"></i>Tính cước dự kiến nhanh</span>
            <small class="text-muted">Nhập thông số:</small>
        </div>
        <div class="row g-2 mb-2">
            <div class="col-4">
                <label class="small text-muted mb-0" style="font-size: 0.7rem;">Gói dịch vụ</label>
                <select id="aiCalcMethod" class="form-select form-select-sm" style="font-size: 0.75rem;">
                    <option value="Thường">Thường</option>
                    <option value="Nhanh">Hỏa tốc</option>
                </select>
            </div>
            <div class="col-4">
                <label class="small text-muted mb-0" style="font-size: 0.7rem;">Khối lượng (kg)</label>
                <input type="number" id="aiCalcWeight" class="form-control form-control-sm" value="2" min="0.1" step="0.5" style="font-size: 0.75rem;" />
            </div>
            <div class="col-4">
                <label class="small text-muted mb-0" style="font-size: 0.7rem;">Cự ly (km)</label>
                <input type="number" id="aiCalcDist" class="form-control form-control-sm" value="5" min="1" step="1" style="font-size: 0.75rem;" />
            </div>
        </div>
        <button type="button" id="aiCalcSubmitBtn" class="btn btn-sm btn-primary-custom w-100 py-1" style="font-size: 0.75rem;">
            <i class="bi bi-lightning-charge me-1"></i> Tính cước & gửi vào chat
        </button>
    </div>

    <!-- KHUNG CHỨA TIN NHẮN (THREAD) -->
    <div class="ai-chat-body" id="aiChatBody">
        <!-- Tin nhắn được render động qua JS bên dưới -->
    </div>

    <!-- CHIP GỢI Ý CÂU HỎI NHANH (NHỎ GỌN, LĂN CHUỘT & KÉO RÊ TRƯỢT NGANG) -->
    <div class="ai-chat-quick-chips" id="aiChatQuickChips">
        <!-- Render động qua JS -->
    </div>

    <!-- KHUNG NHẬP TIN NHẮN -->
    <div class="ai-chat-footer">
        <input type="text" id="aiChatInput" class="ai-chat-input" placeholder="Hỏi AI về đơn hàng, cước phí..." autocomplete="off" />
        <button type="button" id="aiChatSendBtn" class="ai-chat-send-btn" title="Gửi tin nhắn">
            <i class="bi bi-send-fill"></i>
        </button>
    </div>
</div>

<script>
    (function () {
        let conversationId = null;
        let isInitialized = false;

        window.toggleAiChatBox = function (e) {
            if (e) e.stopPropagation();
            const box = document.getElementById('tocdo-ai-chat-box');
            if (!box) return;

            const isShown = box.style.display === 'flex';
            if (isShown) {
                box.style.display = 'none';
            } else {
                box.style.display = 'flex';
                const input = document.getElementById('aiChatInput');
                if (input) input.focus();

                if (!isInitialized) {
                    loadChatData();
                } else {
                    scrollToBottom();
                    setupChipsScroll();
                }
            }
        };

        // Bật/tắt mini calculator
        document.addEventListener('click', function (e) {
            const toggleCalc = e.target.closest('#aiToggleCalcBtn');
            if (toggleCalc) {
                const calc = document.getElementById('ai-mini-calculator');
                if (calc) {
                    calc.style.display = calc.style.display === 'block' ? 'none' : 'block';
                }
            }

            const calcSubmit = e.target.closest('#aiCalcSubmitBtn');
            if (calcSubmit) {
                const w = parseFloat(document.getElementById('aiCalcWeight')?.value) || 2.0;
                const d = parseFloat(document.getElementById('aiCalcDist')?.value) || 5.0;
                const m = document.getElementById('aiCalcMethod')?.value || 'Thường';
                const calc = document.getElementById('ai-mini-calculator');
                if (calc) calc.style.display = 'none';
                sendChatMessage(`Tính cước phí kiện hàng ${w}kg, cự ly ${d}km gói ${m}`);
            }

            const sendBtn = e.target.closest('#aiChatSendBtn');
            if (sendBtn) {
                const input = document.getElementById('aiChatInput');
                if (input && input.value.trim()) {
                    sendChatMessage(input.value.trim());
                    input.value = '';
                }
            }
        });

        // Thiết lập sự kiện cuộn bằng con lăn chuột và kéo rê chuột cho thanh gợi ý
        function setupChipsScroll() {
            const container = document.getElementById('aiChatQuickChips');
            if (!container || container.dataset.scrollBound) return;
            container.dataset.scrollBound = "true";

            // Lăn con lăn chuột để trượt ngang mượt mà
            container.addEventListener('wheel', function (e) {
                if (e.deltaY !== 0) {
                    e.preventDefault();
                    container.scrollLeft += e.deltaY;
                }
            }, { passive: false });

            // Bấm giữ chuột kéo rê sang trái / phải
            let isDown = false;
            let startX;
            let scrollLeftVal;
            let hasDragged = false;

            container.addEventListener('mousedown', function (e) {
                isDown = true;
                hasDragged = false;
                container.classList.add('grabbing');
                startX = e.pageX - container.offsetLeft;
                scrollLeftVal = container.scrollLeft;
            });

            window.addEventListener('mouseup', function () {
                if (isDown) {
                    isDown = false;
                    container.classList.remove('grabbing');
                }
            });

            container.addEventListener('mousemove', function (e) {
                if (!isDown) return;
                e.preventDefault();
                const x = e.pageX - container.offsetLeft;
                const walk = (x - startX) * 1.5;
                if (Math.abs(walk) > 5) hasDragged = true;
                container.scrollLeft = scrollLeftVal - walk;
            });

            // Ngăn click nhầm khi đang kéo rê chuột
            container.addEventListener('click', function (e) {
                if (hasDragged) {
                    e.stopPropagation();
                    e.preventDefault();
                    hasDragged = false;
                }
            }, true);
        }

        // Phím Enter trong ô input
        document.addEventListener('keydown', function (e) {
            if (e.target && e.target.id === 'aiChatInput' && e.key === 'Enter') {
                e.preventDefault();
                const text = e.target.value.trim();
                if (text) {
                    sendChatMessage(text);
                    e.target.value = '';
                }
            }
        });

        async function loadChatData() {
            isInitialized = true;
            const chatBody = document.getElementById('aiChatBody');
            if (chatBody) {
                chatBody.innerHTML = `
                    <div class="text-center py-4 text-muted small" id="aiInitLoading">
                        <div class="spinner-border spinner-border-sm text-primary me-1" role="status"></div>
                        Đang kết nối Trợ lý AI Tốc Độ...
                    </div>
                `;
            }

            try {
                const res = await fetch('/Chat/History');
                const data = await res.json();
                document.getElementById('aiInitLoading')?.remove();

                if (data.success) {
                    conversationId = data.conversationId;
                    if (data.messages && data.messages.length > 0) {
                        data.messages.forEach(m => {
                            appendMessage(m.content, m.isFromAi ? 'ai' : 'user', m.formattedTime);
                        });
                    } else {
                        const greeting = `Xin chào **${data.userFullName || 'bạn'}**! 👋 Em là **Trợ lý AI Tốc Độ**.\nEm có thể hỗ trợ bạn tra cứu đơn hàng, tính cước phí dự kiến hoặc giải đáp các thắc mắc về hàng hóa. Bạn cần em hỗ trợ gì ạ?`;
                        appendMessage(greeting, 'ai', 'Vừa xong');
                    }
                } else {
                    appendMessage("Chào bạn! Em là Trợ lý AI Tốc Độ. Hãy nhắn điều bạn cần hỗ trợ nhé!", 'ai', 'Vừa xong');
                }

                renderQuickChips([
                    "📦 Đơn hàng của tôi",
                    "💰 Tính cước 2kg 10km",
                    "🏷️ Các loại hàng hóa",
                    "📍 Tìm bưu cục"
                ]);
                scrollToBottom();
            } catch (err) {
                console.error(err);
                document.getElementById('aiInitLoading')?.remove();
                appendMessage("Chào bạn! Em là Trợ lý AI Tốc Độ. Bạn cần tra cứu đơn hay tính cước phí gì ạ?", 'ai', 'Vừa xong');
                renderQuickChips([
                    "📦 Đơn hàng của tôi",
                    "💰 Tính cước phí",
                    "🏷️ Loại hàng hóa"
                ]);
            }
        }

        function appendMessage(text, type, timeStr) {
            const chatBody = document.getElementById('aiChatBody');
            if (!chatBody) return;
            const isAi = type === 'ai';
            const row = document.createElement('div');
            row.className = `ai-msg-row ${type}`;

            let formatted = (text || '')
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                .replace(/\n/g, '<br/>');

            row.innerHTML = `
                ${isAi ? '<div class="ai-chat-header-avatar" style="width: 28px; height: 28px; font-size: 13px; flex-shrink: 0;"><i class="bi bi-robot"></i></div>' : ''}
                <div class="ai-msg-bubble">
                    <div>${formatted}</div>
                    <div class="ai-msg-time">${timeStr || 'Vừa xong'}</div>
                </div>
            `;
            chatBody.appendChild(row);
            scrollToBottom();
        }

        function renderQuickChips(chips) {
            const container = document.getElementById('aiChatQuickChips');
            if (!container) return;
            container.innerHTML = '';
            if (!chips || chips.length === 0) return;

            chips.forEach(c => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'ai-chip-btn';
                btn.textContent = c;
                btn.onclick = function (e) {
                    e.preventDefault();
                    sendChatMessage(c);
                };
                container.appendChild(btn);
            });
            setupChipsScroll();
        }

        function scrollToBottom() {
            const chatBody = document.getElementById('aiChatBody');
            if (chatBody) {
                chatBody.scrollTop = chatBody.scrollHeight;
            }
        }

        async function sendChatMessage(text) {
            if (!text || !text.trim()) return;
            const clean = text.trim();
            const input = document.getElementById('aiChatInput');
            if (input) input.value = '';

            appendMessage(clean, 'user', new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }));

            // Typing indicator
            const chatBody = document.getElementById('aiChatBody');
            const typingEl = document.createElement('div');
            typingEl.className = 'ai-msg-row ai';
            typingEl.id = 'aiTypingBubble';
            typingEl.innerHTML = `
                <div class="ai-chat-header-avatar" style="width: 28px; height: 28px; font-size: 13px; flex-shrink: 0;"><i class="bi bi-robot"></i></div>
                <div class="ai-msg-bubble text-muted small" style="background: #ffffff;">
                    <span class="spinner-grow spinner-grow-sm text-warning me-1"></span> AI đang soạn câu trả lời...
                </div>
            `;
            if (chatBody) {
                chatBody.appendChild(typingEl);
                scrollToBottom();
            }

            try {
                const res = await fetch('/Chat/SendMessage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: clean, conversationId: conversationId })
                });
                const data = await res.json();
                typingEl.remove();

                if (data.success) {
                    if (data.conversationId) conversationId = data.conversationId;
                    appendMessage(data.reply, 'ai', new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }));

                    if (data.actionUrl && data.actionText) {
                        const actionRow = document.createElement('div');
                        actionRow.className = 'ai-msg-row ai ps-4';
                        actionRow.innerHTML = `
                            <a href="${data.actionUrl}" class="btn btn-sm btn-tocdo-orange rounded-pill px-3 shadow-sm fw-bold small">
                                ${data.actionText} <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        `;
                        if (chatBody) {
                            chatBody.appendChild(actionRow);
                            scrollToBottom();
                        }
                    }

                    if (data.quickPrompts && data.quickPrompts.length > 0) {
                        renderQuickChips(data.quickPrompts);
                    }
                } else {
                    appendMessage("Rất tiếc, đã xảy ra lỗi kết nối. Vui lòng thử lại sau.", 'ai');
                }
            } catch (err) {
                console.error(err);
                typingEl.remove();
                appendMessage("Không thể gửi tin nhắn. Vui lòng kiểm tra lại kết nối mạng.", 'ai');
            }
        }
    })();
</script>
